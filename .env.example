# Copy this file to `.env` and replace every placeholder with a real value.
#
# Local development:
# - keep ASPNETCORE_ENVIRONMENT=Development
# - demo data and auto-migrations are enabled automatically
#
# Hosted demo:
# - use ASPNETCORE_ENVIRONMENT=Production
# - set Bootstrap__AutoApplyMigrations=true if you want schema changes applied at startup
# - set Bootstrap__EnableDemoData=true if you want the fake demo fleet loaded
#
# Real production-style deploy:
# - use ASPNETCORE_ENVIRONMENT=Production
# - keep Bootstrap__AutoApplyMigrations=false
# - keep Bootstrap__EnableDemoData=false
# - apply database migrations separately during deployment

# ASP.NET Core environment name.
# Development = local dev behavior
# Production  = production middleware, no developer exception page
ASPNETCORE_ENVIRONMENT=Development

# SMTP settings used for registration / confirmation emails.
Email__Host=SMTP_HOST
Email__Port=SMTP_PORT
Email__Username=SMTP_USERNAME
Email__Password=SMTP_PASSWORD
Email__From=EMAIL_FROM
Email__Name=EMAIL_SENDER_NAME

# Main SQL Server connection string for the app database.
ConnectionStrings__DefaultConnection='Server=DB_HOST,DB_PORT;Database=DB_NAME;User Id=DB_USER;Password=DB_PASSWORD;TrustServerCertificate=true'

# Google reCAPTCHA keys for the registration page.
ReCaptcha__SiteKey=RECAPTCHA_SITE_KEY
ReCaptcha__SecretKey=RECAPTCHA_SECRET_KEY

# PayPal API credentials used by the checkout flow.
# Use sandbox for development / demo.
# Use live only for a real deployment with a real merchant account.
Paypal__ClientId=PAYPAL_CLIENT_ID
Paypal__ClientSecret=PAYPAL_CLIENT_SECRET
Paypal__Environment=sandbox

# Bootstrap admin account.
# An initial admin user is seeded on startup when the system has no users in the Admin role.
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword=Admin123!

# Migration switch.
# false = do not auto-run EF Core migrations at startup outside Development
# true  = auto-run pending migrations at startup
Bootstrap__AutoApplyMigrations=false

# Demo data switch.
# false = only seed required bootstrap data (statuses, lookups, first admin)
# true  = also seed the fake demo fleet
Bootstrap__EnableDemoData=false