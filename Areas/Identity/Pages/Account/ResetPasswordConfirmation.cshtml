@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Credential Override Success";
}

<main class="grow flex items-center justify-center pt-32 pb-24 px-6 bg-surface min-h-[calc(100vh-88px)] text-center">
    <div class="w-full max-w-xl bg-surface-container-lowest p-12 md:p-20 shadow-[0_45px_100px_rgba(0,0,0,0.08)] border border-outline-variant/10 relative overflow-hidden group">
        <!-- Corner Decorative Accent -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/10 rounded-bl-full transform translate-x-12 -translate-y-12 transition-transform group-hover:translate-x-10 group-hover:-translate-y-10"></div>
        
        <!-- Header -->
        <header class="mb-14 relative z-10">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-6 block">Recalibration Complete</span>
            <div class="flex justify-center mb-8">
                 <div class="w-20 h-20 bg-black flex items-center justify-center rounded-full shadow-2xl">
                    <span class="material-symbols-outlined text-white text-3xl">verified_user</span>
                </div>
            </div>
            <h1 class="font-headline text-4xl font-black tracking-tighter uppercase mb-6 leading-none">Identity Restored</h1>
            <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-[0.2em] leading-loose max-w-md mx-auto">
                Your high-voltage credentials have been successfully updated. Your previous authorization tokens have been deprecated.
            </p>
        </header>

        <div class="relative z-10 space-y-8">
            <p class="font-label text-[9px] text-outline uppercase tracking-widest italic leading-relaxed">
                Log in with your new secret to regain access to the registry.
            </p>
            <a asp-page="./Login" class="inline-block py-5 px-12 bg-black text-white font-headline text-[11px] font-black uppercase tracking-[0.25em] hover:bg-secondary transition-all duration-500 shadow-2xl">
                Authorize Access
            </a>
        </div>
    </div>
</main>
