@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<main class="min-h-[calc(100vh-88px)] pt-32 pb-24 flex items-center justify-center px-6 bg-surface">
    <div class="w-full max-w-2xl bg-surface-container-lowest p-12 md:p-16 shadow-[0_45px_100px_rgba(0,0,0,0.06)] border border-outline-variant/10 text-center">
        
        <div class="mb-12">
            <span class="material-symbols-outlined text-error text-8xl mb-8">lock</span>
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-error mb-4 block">Access Denied</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-6">@ViewData["Title"]</h1>
            <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-widest leading-loose max-w-md mx-auto">
                You do not have permission to view this page.
            </p>
        </div>

        <div class="py-12 border-t border-b border-outline-variant/10 mb-12">
            <p class="font-body text-[10px] text-outline uppercase tracking-widest leading-relaxed">
                If you believe this is an error, please contact support.
            </p>
        </div>

        <div class="space-y-6">
            <a asp-area="" asp-controller="Home" asp-action="Index" 
               class="block w-full py-6 bg-black text-secondary font-headline text-sm font-black uppercase tracking-[0.2em] hover:opacity-80 transition-opacity duration-500 shadow-2xl">
                HOME
            </a>
            
            <a href="mailto:concierge@luxrentals.com" class="font-label text-[10px] text-on-surface font-black uppercase tracking-widest hover:text-secondary transition-colors block">
                CONTACT SUPPORT
            </a>
        </div>
    </div>
</main>
