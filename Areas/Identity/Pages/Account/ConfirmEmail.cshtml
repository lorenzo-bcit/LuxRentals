@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmation";
    bool isSuccess = Model.StatusMessage?.Contains("Thank you") ?? false;
}

<div class="min-h-[calc(100vh-88px)] pt-32 pb-24 flex items-center justify-center px-6 bg-surface">
    <div class="w-full max-w-lg bg-surface-container-lowest p-12 md:p-16 shadow-[0_40px_60px_rgba(0,0,0,0.04)]">
        <header class="mb-12">
            <h1 class="font-headline text-5xl font-black tracking-tighter text-on-surface mb-2">@ViewData["Title"]</h1>
            <p class="font-label text-xs uppercase tracking-[0.2em] text-outline">Unlock your premium journey</p>
        </header>

        <div class="space-y-10">
            <div class="py-8 border-t border-b border-outline-variant/10">
                @if (isSuccess)
                {
                    <div class="flex flex-col items-center text-center space-y-6">
                        <span class="material-symbols-outlined text-tertiary text-6xl">verified</span>
                        <h2 class="font-headline text-2xl font-bold text-on-surface">@Model.StatusMessage</h2>
                        <p class="font-body text-on-surface-variant leading-relaxed">
                            Your email has been verified. You now have full access to our exclusive fleet of luxury vehicles.
                        </p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col items-center text-center space-y-6">
                        <span class="material-symbols-outlined text-error text-6xl">error</span>
                        <h2 class="font-headline text-2xl font-bold text-on-surface">Email Verification Failed</h2>
                        <p class="font-body text-on-surface-variant leading-relaxed">
                            @Model.StatusMessage
                        </p>
                    </div>
                }
            </div>

            <div class="pt-4">
                @if (isSuccess)
                {
                    <a asp-page="./Login"
                       class="block w-full py-5 bg-on-secondary-fixed text-tertiary-fixed font-headline text-center text-lg font-bold tracking-tight hover:bg-black transition-colors duration-300">
                        PROCEED TO LOGIN
                    </a>
                }
                else
                {
                    <a asp-page="./ResendEmailConfirmation"
                       class="block w-full py-5 bg-on-secondary-fixed text-tertiary-fixed font-headline text-center text-lg font-bold tracking-tight hover:bg-black transition-colors duration-300">
                        RESEND CONFIRMATION
                    </a>
                }
            </div>

        </div>
    </div>
</div>
