@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<main class="grow flex items-center justify-center pt-32 pb-24 px-6 bg-surface min-h-[calc(100vh-88px)]">
    <div class="w-full max-w-xl bg-surface-container-lowest p-12 md:p-14 shadow-[0_45px_100px_rgba(0,0,0,0.08)] border border-outline-variant/10 relative overflow-hidden group">
        <!-- Corner Decorative Accent -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-bl-full transform translate-x-12 -translate-y-12 transition-transform group-hover:translate-x-10 group-hover:-translate-y-10"></div>

        <!-- Header -->
        <header class="mb-14 relative z-10">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-4 block">Retrieve Password</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-6 leading-none">Reset Password</h1>
            <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-widest leading-loose">Enter your email address to reset your password.</p>
        </header>

        <!-- Form -->
        <form method="post" class="space-y-10 relative z-10">
            <div asp-validation-summary="ModelOnly" class="p-4 bg-error-container/10 border-l-4 border-error text-error text-[10px] uppercase tracking-widest font-bold mb-6" role="alert"></div>

            <div class="space-y-2 group/input">
                <label asp-for="Input.Email" class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block transition-colors group-focus-within/input:text-secondary">Email Address</label>
                <div class="relative">
                    <input asp-for="Input.Email" class="ghost-input w-full uppercase tracking-widest text-sm" placeholder="EMAIL@EXAMPLE.COM" autocomplete="username" aria-required="true" />
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-secondary transition-all duration-500 group-focus-within/input:w-full"></span>
                </div>
                <span asp-validation-for="Input.Email" class="text-error text-[9px] uppercase tracking-tighter font-bold"></span>
            </div>

            <div class="pt-6 space-y-6">
                <button type="submit" class="w-full py-5 bg-black text-white font-headline text-sm font-black uppercase tracking-[0.25em] hover:bg-secondary transition-all duration-500 shadow-2xl flex items-center justify-center gap-4">
                    <span>Reset Password</span>
                    <span class="material-symbols-outlined text-sm">key</span>
                </button>

                <div class="text-center pt-8 border-t border-outline-variant/10">
                    <p class="font-label text-[9px] text-outline uppercase tracking-widest mb-4 italic leading-relaxed">
                        An email with reset instructions will be sent to you.
                    </p>
                    <a asp-page="./Login" class="font-label text-[10px] text-on-surface font-black uppercase tracking-widest border-b border-on-surface/20 hover:border-secondary hover:text-secondary transition-all">
                        Back to Login
                    </a>
                </div>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
