@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Credential Reset Dispatched";
}

<main class="grow flex items-center justify-center pt-32 pb-24 px-6 bg-surface min-h-[calc(100vh-88px)] text-center">
    <div class="w-full max-w-xl bg-surface-container-lowest p-12 md:p-20 shadow-[0_45px_100px_rgba(0,0,0,0.08)] border border-outline-variant/10 relative overflow-hidden group">
        <!-- Corner Decorative Accent -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/10 rounded-bl-full transform translate-x-12 -translate-y-12"></div>
        
        <!-- Header -->
        <header class="mb-14 relative z-10">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-6 block">Transmission Finalized</span>
            <div class="flex justify-center mb-8">
                 <div class="w-16 h-16 bg-black flex items-center justify-center rounded-full shadow-2xl">
                    <span class="material-symbols-outlined text-white text-2xl">forward_to_inbox</span>
                </div>
            </div>
            <h1 class="font-headline text-4xl font-black tracking-tighter uppercase mb-6 leading-none">Authorization Dispatched</h1>
            <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-[0.2em] leading-loose max-w-md mx-auto">
                Access instructions have been transmitted to the official registry. Please check your validated mailbox to complete the identity override.
            </p>
        </header>

        <div class="relative z-10 space-y-8">
            <p class="font-label text-[9px] text-outline uppercase tracking-widest italic leading-relaxed">
                If the tether is not received, verify your registry filters or contact embassy support.
            </p>
            <a asp-page="./Login" class="inline-block py-5 px-12 bg-black text-white font-headline text-[11px] font-black uppercase tracking-[0.25em] hover:bg-secondary transition-all duration-500 shadow-2xl">
                Return to Authorization
            </a>
        </div>
    </div>
</main>
