@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Verification";
}

<div class="grow flex items-center justify-center pt-12 pb-20 px-6">
    <div class="w-full max-w-lg bg-surface-container-lowest p-12 md:p-16 shadow-[0_40px_60px_rgba(0,0,0,0.04)]">
        <header class="mb-12">
            <h1 class="font-headline text-5xl font-black tracking-tighter text-on-surface mb-2">@ViewData["Title"]</h1>
            <p class="font-label text-xs uppercase tracking-[0.2em] text-outline">Continue your luxury experience</p>
        </header>

        <form method="post" class="space-y-10">
            <div asp-validation-summary="All" class="text-error font-body text-sm mb-4" role="alert"></div>

            <div class="relative">
                <label asp-for="Input.Email" class="block font-label text-[10px] uppercase tracking-[0.15em] text-outline mb-1">Email Address</label>
                <input asp-for="Input.Email" class="w-full ghost-input py-3 font-body text-on-surface placeholder:text-outline/30 bg-transparent" placeholder="name@example.com" autocomplete="email" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-error text-xs block mt-1"></span>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full py-5 bg-on-secondary-fixed text-tertiary-fixed font-headline text-lg font-bold tracking-tight hover:bg-black transition-colors duration-300">
                    RESEND EMAIL
                </button>
            </div>

            <div class="pt-8 border-t border-outline-variant/10 flex flex-col space-y-4">
                <a asp-page="./Login" class="font-label text-[10px] uppercase tracking-[0.1rem] text-tertiary hover:opacity-70 transition-opacity text-center">Back to Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
