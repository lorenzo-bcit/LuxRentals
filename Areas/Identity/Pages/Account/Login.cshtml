@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="flex-grow flex items-center justify-center pt-12 pb-20 px-6">
    <div class="w-full max-w-lg bg-surface-container-lowest p-12 md:p-16 shadow-[0_40px_60px_rgba(0,0,0,0.04)]">
        <header class="mb-12">
            <h1 class="font-headline text-5xl font-black tracking-tighter text-on-surface mb-2">@ViewData["Title"]</h1>
            <p class="font-label text-xs uppercase tracking-[0.2em] text-outline">Access your exclusive fleet</p>
        </header>
        <form id="account" method="post" class="space-y-10">
            <div asp-validation-summary="ModelOnly" class="text-error font-body text-sm mb-4" role="alert"></div>

            <div class="relative">
                <label asp-for="Input.Email" class="block font-label text-[10px] uppercase tracking-[0.15em] text-outline mb-1">Email Address</label>
                <input asp-for="Input.Email" class="w-full ghost-input py-3 font-body text-on-surface placeholder:text-outline/30 bg-transparent" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-error text-xs block mt-1"></span>
            </div>

            <div class="relative">
                <label asp-for="Input.Password" class="block font-label text-[10px] uppercase tracking-[0.15em] text-outline mb-1">Password</label>
                <input asp-for="Input.Password" class="w-full ghost-input py-3 font-body text-on-surface placeholder:text-outline/30 bg-transparent" placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-error text-xs block mt-1"></span>
            </div>

            <div class="flex items-center space-x-3">
                <input asp-for="Input.RememberMe" class="w-4 h-4 rounded-none border-outline-variant text-tertiary focus:ring-tertiary cursor-pointer" />
                <label asp-for="Input.RememberMe" class="font-label text-[11px] uppercase tracking-wider text-on-surface-variant cursor-pointer">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <div class="pt-4">
                <button id="login-submit" type="submit" class="w-full py-5 bg-on-secondary-fixed text-tertiary-fixed font-headline text-lg font-bold tracking-tight hover:bg-black transition-colors duration-300">
                    Log in
                </button>
            </div>
            
            <div class="mt-12 flex flex-col space-y-4">
                <a id="forgot-password" asp-page="./ForgotPassword" class="font-label text-[10px] uppercase tracking-[0.1rem] text-tertiary hover:text-on-tertiary-fixed-variant transition-colors text-center">Forgot your password?</a>
                <div class="flex items-center justify-center space-x-2 pt-4 border-t border-outline-variant/10">
                    <span class="font-label text-[10px] uppercase tracking-[0.1rem] text-outline">New here?</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-label text-[10px] uppercase tracking-[0.1rem] text-on-surface font-bold hover:text-tertiary transition-colors">Register as a new user</a>
                </div>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="font-label text-[10px] uppercase tracking-[0.1rem] text-outline/60 hover:text-on-surface transition-colors text-center">Resend email confirmation</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
