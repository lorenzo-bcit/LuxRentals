@model LuxRentals.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard">
    <div class="admin-header mb-4">
        <h1><i class="bi bi-shield-lock-fill"></i> Admin Dashboard</h1>
        <p class="text-muted">Welcome back, <strong>@Model.AdminEmail</strong></p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card admin-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="admin-card-icon bg-primary bg-opacity-10 text-primary me-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">@Model.UserCount</h5>
                        <p class="card-text text-muted mb-0">Registered Users</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card admin-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="admin-card-icon bg-success bg-opacity-10 text-success me-3">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">@Model.RoleCount</h5>
                        <p class="card-text text-muted mb-0">Defined Roles</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <h4 class="mb-3">Quick Actions</h4>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card admin-action-card shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-person-vcard display-4" style="color: #e83e8c;"></i>
                    </div>
                    <h5 class="card-title">Manage Profiles</h5>
                    <p class="card-text text-muted">Edit customer profiles in the system.</p>
                    <a asp-area="" asp-controller="Profile" asp-action="Index" class="btn text-white" style="background-color: #e83e8c; border-color: #e83e8c;">
                        <i class="bi bi-arrow-right-circle"></i> Go to Customer Profiles
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card admin-action-card shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-person-badge-fill display-4 text-primary"></i>
                    </div>
                    <h5 class="card-title">Manage Roles</h5>
                    <p class="card-text text-muted">Create, view, and delete roles in the system.</p>
                    <a asp-area="Admin" asp-controller="Role" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-right-circle"></i> Go to Roles
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card admin-action-card shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-people-fill display-4 text-success"></i>
                    </div>
                    <h5 class="card-title">Manage Users</h5>
                    <p class="card-text text-muted">View users and assign or remove their roles.</p>
                    <a asp-area="Admin" asp-controller="UserRole" asp-action="Index" class="btn btn-success">
                        <i class="bi bi-arrow-right-circle"></i> Go to Users
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card admin-action-card shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-car-front-fill display-4 text-warning"></i>
                    </div>
                    <h5 class="card-title">Manage Cars</h5>
                    <p class="card-text text-muted">Add, edit, and remove vehicles from the fleet.</p>
                    <a asp-area="Admin" asp-controller="Cars" asp-action="Index" class="btn btn-warning">
                        <i class="bi bi-arrow-right-circle"></i> Go to Cars
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
