@model LuxRentals.ViewModels.Cars.Admin.CarEditVm

@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="CarThumbnail" type="hidden" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Colour" class="form-label"></label>
        <input asp-for="Colour" class="form-control" />
        <span asp-validation-for="Colour" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FkModelId" class="form-label"></label>
        <select asp-for="FkModelId" asp-items="Model.ModelOptions" class="form-select"></select>
        <span asp-validation-for="FkModelId" class="text-danger"></span>
        <div class="form-text">
            Need a new make or model?
            <a asp-area="Admin" asp-controller="Makes" asp-action="Index" asp-route-returnUrl="@returnUrl">Add make</a>
            or
            <a asp-area="Admin" asp-controller="Models" asp-action="Index" asp-route-returnUrl="@returnUrl">add model</a>.
        </div>
    </div>
    <div class="col-md-6">
        <label asp-for="FkFuelTypeId" class="form-label"></label>
        <select asp-for="FkFuelTypeId" asp-items="Model.FuelTypeOptions" class="form-select"></select>
        <span asp-validation-for="FkFuelTypeId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FkVehicleClassId" class="form-label"></label>
        <select asp-for="FkVehicleClassId" asp-items="Model.VehicleClassOptions" class="form-select"></select>
        <span asp-validation-for="FkVehicleClassId" class="text-danger"></span>
        <div class="form-text">
            Missing a class?
            <a asp-area="Admin" asp-controller="VehicleClasses" asp-action="Index" asp-route-returnUrl="@returnUrl">Add vehicle class</a>.
        </div>
    </div>
    <div class="col-md-6">
        <label asp-for="FkCarStatusId" class="form-label"></label>
        <select asp-for="FkCarStatusId" asp-items="Model.CarStatusOptions" class="form-select"></select>
        <span asp-validation-for="FkCarStatusId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TransmissionType" class="form-label"></label>
        <select asp-for="TransmissionType" asp-items="Model.TransmissionOptions" class="form-select"></select>
        <span asp-validation-for="TransmissionType" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DailyRate" class="form-label"></label>
        <input asp-for="DailyRate" class="form-control" />
        <span asp-validation-for="DailyRate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PersonCap" class="form-label"></label>
        <input asp-for="PersonCap" class="form-control" />
        <span asp-validation-for="PersonCap" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LuggageCap" class="form-label"></label>
        <input asp-for="LuggageCap" class="form-control" />
        <span asp-validation-for="LuggageCap" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="LicencePlate" class="form-label"></label>
        <input asp-for="LicencePlate" class="form-control" />
        <span asp-validation-for="LicencePlate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="VinNumber" class="form-label"></label>
        <input asp-for="VinNumber" class="form-control" />
        <span asp-validation-for="VinNumber" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <div class="form-text">Accepted formats: JPG, PNG, WEBP. Max file size: 5 MB.</div>
        @if (!string.IsNullOrWhiteSpace(Model.CarThumbnail))
        {
            <div class="mt-3">
                <div class="small text-muted mb-2">Current image</div>
                <img src="@Model.CarThumbnail"
                     alt="Current car image"
                     class="img-thumbnail"
                     style="max-width: 240px; max-height: 180px; object-fit: cover;" />
            </div>
        }
    </div>
</div>
