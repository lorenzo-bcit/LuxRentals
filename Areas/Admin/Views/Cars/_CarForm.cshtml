@model LuxRentals.ViewModels.Cars.Admin.AdminCarEditVm

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Car.Year" class="form-label"></label>
        <input asp-for="Car.Year" class="form-control" />
        <span asp-validation-for="Car.Year" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Car.Colour" class="form-label"></label>
        <input asp-for="Car.Colour" class="form-control" />
        <span asp-validation-for="Car.Colour" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Car.FkModelId" class="form-label">Model</label>
        <select asp-for="Car.FkModelId" asp-items="Model.ModelOptions" class="form-select"></select>
        <span asp-validation-for="Car.FkModelId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Car.FkFuelTypeId" class="form-label">Fuel Type</label>
        <select asp-for="Car.FkFuelTypeId" asp-items="Model.FuelTypeOptions" class="form-select"></select>
        <span asp-validation-for="Car.FkFuelTypeId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Car.FkVehicleClassId" class="form-label">Vehicle Class</label>
        <select asp-for="Car.FkVehicleClassId" asp-items="Model.VehicleClassOptions" class="form-select"></select>
        <span asp-validation-for="Car.FkVehicleClassId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Car.FkCarStatusId" class="form-label">Status</label>
        <select asp-for="Car.FkCarStatusId" asp-items="Model.CarStatusOptions" class="form-select"></select>
        <span asp-validation-for="Car.FkCarStatusId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Car.TransmissionType" class="form-label">Transmission</label>
        <select asp-for="Car.TransmissionType" asp-items="Model.TransmissionOptions" class="form-select"></select>
        <span asp-validation-for="Car.TransmissionType" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Car.DailyRate" class="form-label"></label>
        <input asp-for="Car.DailyRate" class="form-control" />
        <span asp-validation-for="Car.DailyRate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Car.PersonCap" class="form-label">Seats</label>
        <input asp-for="Car.PersonCap" class="form-control" />
        <span asp-validation-for="Car.PersonCap" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Car.LuggageCap" class="form-label">Luggage</label>
        <input asp-for="Car.LuggageCap" class="form-control" />
        <span asp-validation-for="Car.LuggageCap" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Car.LicencePlate" class="form-label">Licence Plate</label>
        <input asp-for="Car.LicencePlate" class="form-control" />
        <span asp-validation-for="Car.LicencePlate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Car.VinNumber" class="form-label">VIN</label>
        <input asp-for="Car.VinNumber" class="form-control" />
        <span asp-validation-for="Car.VinNumber" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Car.CarThumbnail" class="form-label">Thumbnail URL</label>
        <input asp-for="Car.CarThumbnail" class="form-control" />
        <span asp-validation-for="Car.CarThumbnail" class="text-danger"></span>
    </div>
</div>
