@model LuxRentals.ViewModels.Cars.Admin.CarEditVm

@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var hasBookings = Model.LockBookedCarFields;
    var lockedFieldsetState = hasBookings ? "disabled" : null;
}

<div asp-validation-summary="ModelOnly" class="mb-8 p-4 bg-error-container/10 border-l-4 border-error text-error text-[10px] uppercase tracking-widest font-bold" role="alert"></div>
<input asp-for="CarThumbnail" type="hidden" />

@if (hasBookings)
{
    <div class="mb-12 p-8 bg-secondary-container/10 border border-secondary/20 flex gap-6 items-start">
        <span class="material-symbols-outlined text-secondary">warning</span>
        <div class="space-y-2">
            <h4 class="font-label text-[10px] font-black uppercase tracking-widest text-secondary">Active Occupancy Detected</h4>
            <p class="font-body text-xs text-on-surface-variant leading-relaxed">This asset has active or upcoming reservations. Specs are locked, but status can still switch between Available and Booking Hold.</p>
        </div>
    </div>
}

<div class="space-y-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
        <div class="space-y-2">
            <label asp-for="FkCarStatusId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Inventory Status</label>
            <select asp-for="FkCarStatusId" asp-items="Model.CarStatusOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer"></select>
            <span asp-validation-for="FkCarStatusId" class="text-error text-[9px] uppercase font-bold"></span>
        </div>
    </div>

    <fieldset disabled="@lockedFieldsetState" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 disabled:opacity-60">

        <div class="space-y-2">
            <label asp-for="Year" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Model Year</label>
            <input asp-for="Year" class="ghost-input w-full uppercase tracking-widest text-sm" placeholder="2026" />
            <span asp-validation-for="Year" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="Colour" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Exterior Palette</label>
            <input asp-for="Colour" class="ghost-input w-full uppercase tracking-widest text-sm" placeholder="ONYX BLACK" />
            <span asp-validation-for="Colour" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="FkModelId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Manufacturer Model</label>
            <select asp-for="FkModelId" asp-items="Model.ModelOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer"></select>
            <span asp-validation-for="FkModelId" class="text-error text-[9px] uppercase font-bold"></span>
            @if (!hasBookings)
            {
                <div class="pt-2 flex items-center gap-2">
                    <span class="text-[9px] text-on-surface-variant uppercase tracking-tighter italic">Archive missing?</span>
                    <a asp-area="Admin" asp-controller="Makes" asp-action="Index" asp-route-returnUrl="@returnUrl" class="text-[9px] text-secondary font-bold uppercase tracking-widest hover:underline">Marques</a>
                    <span class="text-[9px] text-on-surface-variant">/</span>
                    <a asp-area="Admin" asp-controller="Models" asp-action="Index" asp-route-returnUrl="@returnUrl" class="text-[9px] text-secondary font-bold uppercase tracking-widest hover:underline">Models</a>
                </div>
            }
        </div>

        <div class="space-y-2">
            <label asp-for="FkFuelTypeId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Propulsion Methodology</label>
            <select asp-for="FkFuelTypeId" asp-items="Model.FuelTypeOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer"></select>
            <span asp-validation-for="FkFuelTypeId" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="FkVehicleClassId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Asset Category</label>
            <select asp-for="FkVehicleClassId" asp-items="Model.VehicleClassOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer"></select>
            <span asp-validation-for="FkVehicleClassId" class="text-error text-[9px] uppercase font-bold"></span>
            @if (!hasBookings)
            {
                <div class="pt-2">
                    <a asp-area="Admin" asp-controller="VehicleClasses" asp-action="Index" asp-route-returnUrl="@returnUrl" class="text-[9px] text-secondary font-bold uppercase tracking-widest hover:underline italic">Segment missing? Register class here.</a>
                </div>
            }
        </div>

        <div class="space-y-2">
            <label asp-for="TransmissionType" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Transmission Logic</label>
            <select asp-for="TransmissionType" asp-items="Model.TransmissionOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer"></select>
            <span asp-validation-for="TransmissionType" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="DailyRate" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Daily Valuation (CAD)</label>
            <input asp-for="DailyRate" class="ghost-input w-full font-headline text-lg font-black text-secondary uppercase tracking-widest" placeholder="250.00" />
            <span asp-validation-for="DailyRate" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="PersonCap" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Lounge Capacity</label>
            <input asp-for="PersonCap" class="ghost-input w-full uppercase tracking-widest text-sm" placeholder="2" />
            <span asp-validation-for="PersonCap" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="LuggageCap" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Storage Capability</label>
            <input asp-for="LuggageCap" class="ghost-input w-full uppercase tracking-widest text-sm" placeholder="2" />
            <span asp-validation-for="LuggageCap" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="LicencePlate" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Regional Identifier (PLATE)</label>
            <input asp-for="LicencePlate" class="ghost-input w-full uppercase tracking-widest text-sm font-mono" placeholder="LUX-001" />
            <span asp-validation-for="LicencePlate" class="text-error text-[9px] uppercase font-bold"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="VinNumber" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Master Registry (VIN)</label>
            <input asp-for="VinNumber" class="ghost-input w-full uppercase tracking-widest text-sm font-mono" placeholder="VIN MASTER CODE" />
            <span asp-validation-for="VinNumber" class="text-error text-[9px] uppercase font-bold"></span>
        </div>
    </fieldset>

    @if (hasBookings)
    {
        <input asp-for="Year" type="hidden" />
        <input asp-for="Colour" type="hidden" />
        <input asp-for="FkModelId" type="hidden" />
        <input asp-for="FkFuelTypeId" type="hidden" />
        <input asp-for="FkVehicleClassId" type="hidden" />
        <input asp-for="TransmissionType" type="hidden" />
        <input asp-for="DailyRate" type="hidden" />
        <input asp-for="PersonCap" type="hidden" />
        <input asp-for="LuggageCap" type="hidden" />
        <input asp-for="LicencePlate" type="hidden" />
        <input asp-for="VinNumber" type="hidden" />
    }

    <div class="pt-12 border-t border-outline-variant/10">
        <label asp-for="ImageFile" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block mb-6">Visual Repository Documentation</label>
        
        <div class="flex flex-col md:flex-row gap-12 items-start">
            <div class="grow space-y-4">
                 <input asp-for="ImageFile" class="block w-full text-xs text-on-surface-variant file:mr-8 file:py-4 file:px-8 file:border-0 file:text-[10px] file:font-black file:uppercase file:tracking-widest file:bg-black file:text-white hover:file:bg-secondary transition-all cursor-pointer bg-surface-container-low/30 border border-dashed border-outline-variant/40 p-8" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                 <span asp-validation-for="ImageFile" class="text-error text-[9px] uppercase font-bold"></span>
                 <p class="text-[9px] uppercase tracking-widest text-on-surface-variant italic">Accepted formats: High-Resolution JPG, PNG, WEBP. Master limits apply.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CarThumbnail))
            {
                <div class="shrink-0 space-y-3">
                    <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Current Documentation</span>
                    <div class="w-48 aspect-3/2 border border-outline-variant/30 overflow-hidden bg-surface-container">
                        <img src="@Model.CarThumbnail" alt="Recorded asset visual" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>
