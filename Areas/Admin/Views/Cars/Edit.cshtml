@model LuxRentals.ViewModels.Cars.Admin.CarEditVm

@{
    ViewData["Title"] = "Edit Car";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Edit Car</h1>
            <p class="text-muted mb-0">Update the selected inventory record.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Cars" asp-action="Index">Back to Inventory</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" asp-area="Admin" asp-controller="Cars" asp-action="Edit" asp-route-id="@Model.CarId">
                <input asp-for="CarId" type="hidden" />
                <partial name="_CarForm" model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Cars" asp-action="Index">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.ActiveOrUpcomingBookings.Count > 0)
    {
        <div class="card border-warning shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-2">Current and Upcoming Bookings</h2>
                <p class="text-muted mb-3">These bookings may need to be resolved before changing this car to an unavailable status.</p>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Customer</th>
                                <th>Pickup</th>
                                <th>Return</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var booking in Model.ActiveOrUpcomingBookings)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(booking.IsActive ? "bg-primary" : "bg-success")">
                                        @(booking.IsActive ? "Active" : "Upcoming")
                                    </span>
                                </td>
                                <td>@booking.CustomerName</td>
                                <td>@booking.StartDate.ToString("yyyy-MM-dd")</td>
                                <td>@booking.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-area=""
                                       asp-controller="Booking"
                                       asp-action="ViewCustomerBookings"
                                       asp-route-customerId="@booking.CustomerId">
                                        View Customer Bookings
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
