@model LuxRentals.ViewModels.Cars.Admin.CarEditVm

@{
    ViewData["Title"] = "Modify Asset Record";
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12 bg-surface">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-12">
        <div class="max-w-xl">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Technical Archive</span>
            <h1 class="font-headline text-3xl md:text-5xl font-black tracking-tighter uppercase mb-6">Modify Asset</h1>
            <p class="font-body text-[10px] text-on-surface-variant uppercase tracking-widest leading-loose">Updating the master technical specifications and availability status for the selected automotive asset.</p>
        </div>
        <div class="text-right">
             <a asp-area="Admin" asp-controller="Cars" asp-action="Index" class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Inventory Archive
            </a>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mb-12 p-6 bg-secondary-container/10 border-l-4 border-secondary text-secondary text-xs uppercase tracking-widest font-bold" role="alert">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold" role="alert">@errorMessage</div>
    }

    <!-- Workspace -->
    <div class="bg-surface-container-lowest p-10 md:p-16 border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.08)] relative overflow-hidden mb-24">
        <div class="absolute top-0 right-0 w-96 h-96 bg-secondary/5 rounded-bl-full transform translate-x-32 -translate-y-32"></div>
        
        <form method="post" enctype="multipart/form-data" asp-area="Admin" asp-controller="Cars" asp-action="Edit" asp-route-id="@Model.CarId" class="relative z-10 space-y-16">
            <input asp-for="CarId" type="hidden" />
            <partial name="_CarForm" model="Model" />

            <div class="pt-16 border-t border-outline-variant/10 flex flex-col sm:flex-row justify-end gap-6">
                 <a asp-action="Index" class="border border-on-surface px-12 py-5 font-label text-[10px] font-bold uppercase tracking-widest hover:bg-on-surface hover:text-white transition-all text-center">
                    Discard Changes
                </a>
                <button type="submit" class="bg-black text-white px-16 py-5 font-label text-[10px] font-bold uppercase tracking-widest hover:bg-secondary transition-colors shadow-2xl">
                    Save Metadata
                </button>
            </div>
        </form>
    </div>

    <!-- Linked Reservations -->
    @if (Model.ActiveOrUpcomingBookings.Count > 0)
    {
        <div class="space-y-12">
            <div class="flex items-center justify-between">
                <h2 class="font-headline text-2xl font-black uppercase tracking-tight">Contractual Obligations</h2>
                <div class="h-px flex-grow bg-outline-variant/20 mx-8"></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left font-body text-xs border-collapse">
                        <thead>
                            <tr class="border-b border-outline-variant/20 bg-surface-container-low/30 font-label text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                                <th class="py-8 px-10">Occupancy Status</th>
                                <th class="py-8 px-10">Contract Holder</th>
                                <th class="py-8 px-10">Collection Window</th>
                                <th class="py-8 px-10 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10">
                            @foreach (var booking in Model.ActiveOrUpcomingBookings)
                            {
                                <tr class="group hover:bg-surface-container-low/20 transition-colors duration-500">
                                    <td class="py-8 px-10">
                                        <div class="flex items-center gap-4">
                                            <div class="w-2 h-2 rounded-full @(booking.IsActive ? "bg-secondary" : "bg-on-surface/30")"></div>
                                            <span class="font-label text-[9px] font-black uppercase tracking-widest @(booking.IsActive ? "text-secondary" : "text-on-surface-variant")">
                                                @(booking.IsActive ? "Active Engagement" : "Upcoming Reservation")
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-8 px-10">
                                        <a asp-area="" asp-controller="Booking" asp-action="ViewCustomerBookings" asp-route-customerId="@booking.CustomerId" target="_blank" rel="noopener noreferrer" class="font-headline text-lg font-bold group-hover:text-secondary transition-colors inline-flex items-center gap-2">
                                            @booking.CustomerName
                                            <span class="material-symbols-outlined text-sm opacity-50 group-hover:opacity-100">open_in_new</span>
                                        </a>
                                    </td>
                                    <td class="py-8 px-10 font-label text-[10px] uppercase tracking-widest">
                                        <div class="flex items-center gap-4 text-on-surface-variant">
                                            <span>@booking.StartDate.ToString("yyyy-MM-dd")</span>
                                            <span class="w-8 h-px bg-outline-variant/20"></span>
                                            <span>@booking.EndDate.ToString("yyyy-MM-dd")</span>
                                        </div>
                                    </td>
                                    <td class="py-8 px-10 text-right">
                                        <a asp-area="" asp-controller="Booking" asp-action="Cancel" asp-route-id="@booking.BookingId" asp-route-returnCarId="@Model.CarId" class="inline-flex items-center gap-2 border border-error/20 text-error px-6 py-3 font-label text-[9px] font-black uppercase tracking-widest hover:bg-error hover:text-white transition-all opacity-100 lg:opacity-0 lg:group-hover:opacity-100 duration-500">
                                            Terminate Contract
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
