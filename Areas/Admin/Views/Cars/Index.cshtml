@model LuxRentals.ViewModels.Cars.Admin.AdminCarIndexVm

@{
    ViewData["Title"] = "Admin Cars";
}

<section class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Fleet Inventory</h1>
            <p class="text-muted mb-0">Manage all cars, including unavailable inventory.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Makes" asp-action="Index">Manage Makes</a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Models" asp-action="Index">Manage Models</a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="VehicleClasses" asp-action="Index">Manage Classes</a>
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Cars" asp-action="Create">Add Car</a>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th>Car</th>
                    <th>Status</th>
                    <th>Specs</th>
                    <th>Plate</th>
                    <th>VIN</th>
                    <th class="text-end">Daily Rate</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Cars.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No cars found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var car in Model.Cars)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@car.DisplayName</div>
                                <div class="text-muted small">@car.VehicleClass</div>
                            </td>
                            <td>
                                <span class="badge text-bg-secondary">@car.Status</span>
                            </td>
                            <td class="small text-muted">@car.Transmission • @car.FuelType</td>
                            <td>@car.LicencePlate</td>
                            <td class="small">@car.VinNumber</td>
                            <td class="text-end">@car.DailyRate.ToString("C")</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-area="Admin"
                                       asp-controller="Cars"
                                       asp-action="Edit"
                                       asp-route-id="@car.CarId">Edit</a>
                                    <form method="post"
                                          asp-area="Admin"
                                          asp-controller="Cars"
                                          asp-action="Delete"
                                          asp-route-id="@car.CarId"
                                          onsubmit="return confirm('Delete this car? Cars with bookings will be moved Out of Service instead.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <nav aria-label="Admin car pages" class="d-flex justify-content-center align-items-center gap-3 mt-4">
        <a class="btn btn-outline-dark @(Model.HasPreviousPage ? "" : "disabled")"
           asp-area="Admin"
           asp-controller="Cars"
           asp-action="Index"
           asp-route-page="@(Model.Page - 1)">Previous</a>
        <span class="text-muted">Page @Model.Page of @Model.TotalPages</span>
        <a class="btn btn-outline-dark @(Model.HasNextPage ? "" : "disabled")"
           asp-area="Admin"
           asp-controller="Cars"
           asp-action="Index"
           asp-route-page="@(Model.Page + 1)">Next</a>
    </nav>
</section>
