@model LuxRentals.ViewModels.Cars.Admin.MakeIndexVm

@{
    ViewData["Title"] = "Manufacturer Records";
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12 bg-surface">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-8">
        <div>
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Enterprise Assets</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-4">Manufacturer Records</h1>
            <p class="font-body text-xs text-on-surface-variant uppercase tracking-widest opacity-80">Cataloging the prestigious global marques within our collection.</p>
        </div>
        <div class="text-right">
             @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
             {
                <a class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all" href="@Model.ReturnUrl">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Return to Asset
                </a>
             }
             else
             {
                <a class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all" asp-area="Admin" asp-controller="Cars" asp-action="Index">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Inventory
                </a>
             }
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mb-12 p-6 bg-secondary-container/10 border-l-4 border-secondary text-secondary text-xs uppercase tracking-widest font-bold" role="alert">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold" role="alert">@errorMessage</div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        <!-- Add Make form -->
        <div class="lg:col-span-5">
            <div class="bg-surface-container-lowest p-10 border border-outline-variant/10 shadow-[0_25px_70px_rgba(0,0,0,0.05)] h-fit">
                <h3 class="font-headline text-xl font-bold uppercase tracking-tight mb-8">Establish New Marque</h3>
                
                <form method="post" asp-area="Admin" asp-controller="Makes" asp-action="Create" class="space-y-10">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-error text-[10px] uppercase font-bold tracking-widest"></div>

                    <div class="space-y-4">
                        <label asp-for="MakeName" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant block">Manufacturer Name</label>
                        <input asp-for="MakeName" class="ghost-input w-full uppercase tracking-widest text-sm" placeholder="E.G. PORSCHE" />
                        <span asp-validation-for="MakeName" class="text-error text-[9px] uppercase font-black"></span>
                    </div>

                    <button type="submit" class="w-full bg-black text-white text-center py-5 font-label text-[10px] font-bold uppercase tracking-widest hover:bg-secondary transition-colors shadow-2xl">
                        Register Manufacturer
                    </button>
                </form>
            </div>
        </div>

        <!-- Current Makes table -->
        <div class="lg:col-span-7">
            <div class="bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
                <table class="w-full text-left font-body text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-outline-variant/20 bg-surface-container-low/30 font-label text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                            <th class="py-6 px-10">Marque Title</th>
                            <th class="py-6 px-10 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/10">
                        @if (Model.Makes.Count == 0)
                        {
                            <tr>
                                <td colspan="2" class="py-24 text-center">
                                    <span class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">No marques recorded in our archive.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var make in Model.Makes)
                            {
                                <tr class="group hover:bg-surface-container-low/20 transition-colors duration-500">
                                    <td class="py-6 px-10 font-headline font-bold text-lg uppercase tracking-tight">@make.MakeName</td>
                                    <td class="py-6 px-10 text-right">
                                        <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                                            <a asp-action="Edit" asp-route-id="@make.MakeId" asp-route-returnUrl="@Model.ReturnUrl" class="w-10 h-10 flex items-center justify-center border border-on-surface/20 text-on-surface hover:bg-black hover:text-white transition-all">
                                                <span class="material-symbols-outlined text-sm">edit</span>
                                            </a>
                                            @if (make.CanDelete)
                                            {
                                                <form method="post" asp-action="Delete" asp-route-id="@make.MakeId" asp-route-returnUrl="@Model.ReturnUrl" class="inline">
                                                    <button type="submit" class="w-10 h-10 flex items-center justify-center border border-error/20 text-error hover:bg-error hover:text-white transition-all">
                                                        <span class="material-symbols-outlined text-sm">delete</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
