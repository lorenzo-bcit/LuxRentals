@model IEnumerable<LuxRentals.ViewModels.Roles.RoleVm>
@{
    ViewData["Title"] = "Role Registry";
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12 bg-surface">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-8">
        <div>
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Access Control</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-4">Role Registry</h1>
            <p class="font-body text-xs text-on-surface-variant uppercase tracking-widest opacity-80">Define the organizational hierarchy and system authority levels.</p>
        </div>
        <div class="text-right">
             <a asp-action="Create" class="bg-black text-white text-center py-4 px-10 font-label text-[10px] font-bold uppercase tracking-widest hover:bg-secondary transition-colors shadow-2xl">
                Create Requirement
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-12 p-6 bg-secondary-container/10 border-l-4 border-secondary text-secondary text-xs uppercase tracking-widest font-bold" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
        <table class="w-full text-left font-body text-xs border-collapse">
            <thead>
                <tr class="border-b border-outline-variant/20 bg-surface-container-low/30 font-label text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                    <th class="py-8 px-10">Identifier</th>
                    <th class="py-8 px-10 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10">
                @if (Model.Any())
                {
                    @foreach (var role in Model)
                    {
                        <tr class="group hover:bg-surface-container-low/20 transition-colors duration-500">
                            <td class="py-8 px-10">
                                <div class="flex items-center gap-4">
                                    <div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                                    <span class="font-headline font-bold text-lg uppercase tracking-tight">@role.RoleName</span>
                                </div>
                            </td>
                            <td class="py-8 px-10 text-right">
                                <a asp-action="Delete" asp-route-id="@role.Id" class="inline-flex items-center justify-center p-4 border border-error/20 text-error hover:bg-error hover:text-white transition-all opacity-0 group-hover:opacity-100 duration-500">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="py-24 text-center">
                            <span class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">No authority roles established.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-12 flex justify-start">
        <a asp-area="Admin" asp-controller="AdminProfile" asp-action="Index" class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Dashboard
        </a>
    </div>
</main>
