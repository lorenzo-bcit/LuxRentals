@model LuxRentals.ViewModels.Cars.Admin.AdminModelEditVm

@{
    ViewData["Title"] = "Edit Model";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Edit Model</h1>
            <p class="text-muted mb-0">Update the make or model name used by car inventory.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">Back to Car</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Models" asp-action="Index">Back to Models</a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form method="post" asp-area="Admin" asp-controller="Models" asp-action="Edit" asp-route-id="@Model.ModelId">
                <input asp-for="ModelId" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FkMakeId" class="form-label"></label>
                    <select asp-for="FkMakeId" asp-items="Model.MakeOptions" class="form-select"></select>
                    <span asp-validation-for="FkMakeId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ModelName" class="form-label"></label>
                    <input asp-for="ModelName" class="form-control" />
                    <span asp-validation-for="ModelName" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary"
                       asp-area="Admin"
                       asp-controller="Models"
                       asp-action="Index"
                       asp-route-returnUrl="@Model.ReturnUrl">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
