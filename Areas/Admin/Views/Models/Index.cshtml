@model LuxRentals.ViewModels.Cars.Admin.AdminModelIndexVm

@{
    ViewData["Title"] = "Manage Models";
}

<section class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Manage Models</h1>
            <p class="text-muted mb-0">Attach new models to an existing make.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">Back to Car</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Cars" asp-action="Index">Back to Inventory</a>
        }
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Add Model</h2>

                    <form method="post" asp-area="Admin" asp-controller="Models" asp-action="Create">
                        <input asp-for="ReturnUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FkMakeId" class="form-label"></label>
                            <select asp-for="FkMakeId" asp-items="Model.MakeOptions" class="form-select"></select>
                            <span asp-validation-for="FkMakeId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ModelName" class="form-label"></label>
                            <input asp-for="ModelName" class="form-control" />
                            <span asp-validation-for="ModelName" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Add Model</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Current Models</h2>

                    @if (Model.Models.Count == 0)
                    {
                        <p class="text-muted mb-0">No models found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>Make</th>
                                    <th>Model</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model.Models)
                                {
                                    <tr>
                                        <td>@item.MakeName</td>
                                        <td>@item.ModelName</td>
                                        <td>
                                            <div class="d-flex justify-content-end gap-2">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-area="Admin"
                                                   asp-controller="Models"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.ModelId"
                                                   asp-route-returnUrl="@Model.ReturnUrl">Edit</a>
                                                @if (item.CanDelete)
                                                {
                                                    <form method="post"
                                                          asp-area="Admin"
                                                          asp-controller="Models"
                                                          asp-action="Delete"
                                                          asp-route-id="@item.ModelId"
                                                          asp-route-returnUrl="@Model.ReturnUrl">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>In Use</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
