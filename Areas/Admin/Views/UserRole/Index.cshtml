@model IEnumerable<LuxRentals.ViewModels.UserVm>
@{
    ViewData["Title"] = "User Directory";
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12 bg-surface flex flex-col min-h-screen">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-12">
        <div class="max-w-xl">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">System Administration</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-6">User Directory</h1>
            <p class="font-body text-[10px] text-on-surface-variant uppercase tracking-widest leading-loose">Monitor user activity and assign specialized high-level system permissions.</p>
        </div>
        <div class="text-right">
             <div class="flex items-center gap-3 text-secondary justify-end mb-2">
                <span class="material-symbols-outlined text-sm">group</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-widest">Active Directory Control</span>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-12 p-6 bg-secondary-container/10 border-l-4 border-secondary text-secondary text-xs uppercase tracking-widest font-bold" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
        <table class="w-full text-left font-body text-xs border-collapse">
            <thead>
                <tr class="border-b border-outline-variant/20 bg-surface-container-low/30 font-label text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                    <th class="py-8 px-10">Account Identifier</th>
                    <th class="py-8 px-10 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10">
                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr class="group hover:bg-surface-container-low/20 transition-colors duration-500">
                            <td class="py-8 px-10">
                                <div class="flex items-center gap-6">
                                    <div class="w-12 h-12 bg-surface-container flex items-center justify-center border border-outline-variant/20 rounded-full group-hover:bg-black group-hover:text-white transition-all duration-500">
                                        <span class="material-symbols-outlined text-sm">person</span>
                                    </div>
                                    <span class="font-headline font-bold text-lg lowercase tracking-tight">@user.Email</span>
                                </div>
                            </td>
                            <td class="py-8 px-10 text-right">
                                <a asp-action="Detail" asp-route-userName="@user.Email" class="inline-flex items-center justify-center py-4 px-8 border border-on-surface/20 text-on-surface font-label text-[10px] font-bold uppercase tracking-widest hover:bg-black hover:text-white hover:border-black transition-all opacity-0 group-hover:opacity-100 duration-500">
                                    View Authority
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="py-24 text-center">
                            <span class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">No system users identified.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-12 flex justify-start">
        <a asp-area="Admin" asp-controller="AdminProfile" asp-action="Index" class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Dashboard
        </a>
    </div>
</main>
