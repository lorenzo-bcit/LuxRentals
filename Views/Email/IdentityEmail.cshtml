@model LuxRentals.ViewModels.Email.IdentityEmailTemplateModel
<!DOCTYPE html>
<html lang="en">
<body style="margin:0;padding:24px;background:#f5f1e8;font-family:Segoe UI,Arial,sans-serif;color:#1f2937;">
  <table role="presentation" style="width:100%;border-collapse:collapse;border-spacing:0;">
    <tr>
      <td style="text-align:center;">
        <table role="presentation" style="width:100%;max-width:640px;margin:0 auto;border-collapse:collapse;border-spacing:0;background:#ffffff;border-radius:20px;overflow:hidden;">
          <tr>
            <td style="padding:28px 36px;background:#111827;color:#ffffff;">
              <div style="font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#d4b06a;margin-bottom:10px;">LuxRentals</div>
              <div style="font-size:28px;font-weight:700;line-height:1.2;">@Model.Subject</div>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 36px;font-size:16px;line-height:1.7;color:#374151;">
              @Model.HtmlMessage
            </td>
          </tr>
          <tr>
            <td style="padding:0 36px 32px 36px;font-size:13px;line-height:1.6;color:#6b7280;">
              If you were not expecting this email, you can safely ignore it.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
