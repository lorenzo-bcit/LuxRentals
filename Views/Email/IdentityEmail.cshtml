@model LuxRentals.ViewModels.Email.IdentityEmailTemplateModel
<!DOCTYPE html>
<html lang="en">
<body style="margin:0;padding:24px;background:#f9f9f9;font-family:Arial,Helvetica,sans-serif;color:#111111;">
  <table role="presentation" style="width:100%;border-collapse:collapse;border-spacing:0;">
    <tr>
      <td style="text-align:center;">
        <table role="presentation" style="width:100%;max-width:640px;margin:0 auto;border-collapse:collapse;border-spacing:0;background:#ffffff;border:1px solid #e5e7eb;border-radius:20px;overflow:hidden;">
          <tr>
            <td style="padding:28px 36px;background:#111111;color:#ffffff;">
              <div style="font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#c5a059;margin-bottom:10px;font-weight:700;">LuxRentals</div>
              <div style="font-size:32px;font-weight:700;line-height:1.15;font-family:Georgia,'Times New Roman',serif;font-style:italic;">@Model.Subject</div>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 36px;font-size:16px;line-height:1.8;color:#374151;">
              @Model.HtmlMessage
            </td>
          </tr>
          <tr>
            <td style="padding:0 36px 32px 36px;font-size:12px;line-height:1.7;color:#6b7280;">
              If you were not expecting this email, you can safely ignore it.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
