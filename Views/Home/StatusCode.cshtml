@model int
@{
    var isNotFound = Model == 404;
    var label = isNotFound ? "Route Unavailable" : "Request Blocked";
    var title = isNotFound ? "Page Not Found" : $"Status {Model}";
    var message = isNotFound
        ? "The destination you requested is not part of the current LuxRentals route map."
        : "The request completed with an unexpected status code. Return to a known page and continue from there.";

    ViewData["Title"] = title;
}

<main class="min-h-[calc(100vh-88px)] pt-32 pb-24 px-6 bg-surface">
    <section class="max-w-3xl mx-auto">
        <div class="bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
            <div class="px-8 py-10 md:px-12 md:py-12 border-b border-outline-variant/10 bg-[linear-gradient(135deg,rgba(197,160,89,0.08),transparent_60%)]">
                <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-4 block">@label</span>
                <div class="flex items-end gap-4 mb-4">
                    <span class="font-headline text-6xl md:text-7xl font-black tracking-tighter text-on-surface">@Model</span>
                    <h1 class="font-headline text-3xl md:text-5xl font-black tracking-tighter uppercase text-on-surface">@title</h1>
                </div>
                <p class="font-body text-[11px] uppercase tracking-widest leading-loose text-on-surface-variant max-w-xl">
                    @message
                </p>
            </div>

            <div class="px-8 py-10 md:px-12 md:py-12 space-y-8">
                <div class="flex items-start gap-4">
                    <span class="material-symbols-outlined text-secondary text-4xl">explore_off</span>
                    <div>
                        <p class="font-headline text-2xl font-black tracking-tight uppercase text-on-surface">Use a known route</p>
                        <p class="font-body text-sm leading-relaxed text-on-surface-variant max-w-xl">
                            The fastest recovery is to return home or continue to the fleet catalog.
                        </p>
                    </div>
                </div>

                <div class="flex flex-col gap-4 sm:flex-row">
                    <a asp-controller="Home" asp-action="Index" class="flex-1 py-5 bg-black text-white text-center font-label text-[10px] font-black uppercase tracking-[0.3em] hover:bg-secondary transition-all duration-500 shadow-2xl">
                        Return Home
                    </a>
                    <a asp-controller="Cars" asp-action="Index" class="flex-1 py-5 border border-on-surface/15 text-center font-label text-[10px] font-black uppercase tracking-[0.3em] text-on-surface hover:bg-black hover:text-white transition-all duration-500">
                        Browse Fleet
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>
