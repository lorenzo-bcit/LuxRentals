@{
    ViewData["Title"] = "Security & Privacy Protocol";
}

<main class="pt-40 pb-32 max-w-4xl mx-auto px-6 md:px-12 bg-surface min-h-[calc(100vh-88px)]">
    <!-- Header -->
    <header class="mb-20 border-b border-outline-variant/20 pb-12">
        <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-4 block">Confidentiality Agreement</span>
        <h1 class="font-headline text-3xl md:text-5xl font-black tracking-tighter uppercase mb-6">Privacy Registry</h1>
        <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-widest leading-loose">
            LuxRentals commitment to the protection and absolute discretion of executive client telemetry.
        </p>
    </header>

    <!-- Content -->
    <div class="space-y-16 prose prose-stone max-w-none">
        <section class="space-y-6">
            <h2 class="font-headline text-2xl font-black uppercase tracking-tight text-on-surface">01. Data Collection Protocol</h2>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                We gather only the most essential telemetry required to navigate the LuxRentals ecosystem. This includes verified identity credentials, communication channels, and automotive preferences established during your engagement.
            </p>
        </section>

        <section class="space-y-6">
            <h2 class="font-headline text-2xl font-black uppercase tracking-tight text-on-surface">02. Security Shielding</h2>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                Your dossier is protected by military-grade encryption and strict access controls. Only authorized personnel at the LuxRentals Embassy may access your sensitive information, ensuring your privacy remains as secluded as the destinations you explore.
            </p>
        </section>

        <section class="space-y-6">
            <h2 class="font-headline text-2xl font-black uppercase tracking-tight text-on-surface">03. Confidential Settlement</h2>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                Financial transactions are processed via the secure PayPal network. LuxRentals never stores your decrypted settlement credentials, preserving a layer of absolute transactional anonymity between the client and the institution.
            </p>
        </section>

        <section class="pt-12 border-t border-outline-variant/10">
             <div class="flex items-center gap-6">
                <div class="w-12 h-px bg-secondary"></div>
                <span class="font-label text-[10px] font-black uppercase tracking-widest text-on-surface">Validated Archive &bull; 2026 Edition</span>
            </div>
        </section>
    </div>
</main>