@model IEnumerable<LuxRentals.ViewModels.Roles.RoleVm>
@{
    ViewData["Title"] = "User Roles";
}

<div class="admin-section">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-lines-fill"></i> Roles for User</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-envelope"></i> <strong>@ViewBag.UserName</strong>
            </p>
        </div>
        <a asp-action="Create" asp-route-userName="@ViewBag.UserEmail" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Assign Role
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover admin-table mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Role Name</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-info text-dark me-2">@role.RoleName</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Delete"
                                       asp-route-email="@ViewBag.UserEmail"
                                       asp-route-role="@role.RoleName"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle"></i> Remove
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                This user has no roles assigned.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Users
        </a>
    </div>
</div>
