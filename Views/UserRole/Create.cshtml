@model LuxRentals.ViewModels.Roles.UserRoleVm
@{
    ViewData["Title"] = "Assign Role";
}

<div class="admin-section">
    <h2 class="mb-4"><i class="bi bi-person-plus-fill"></i> Assign Role to User</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">User</label>
                            <select asp-for="Email" class="form-select"
                                    asp-items="@((SelectList)ViewBag.UserSelectList)">
                                <option value="">-- Select a User --</option>
                            </select>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-semibold">Role</label>
                            <select asp-for="Role" class="form-select"
                                    asp-items="@((SelectList)ViewBag.RoleSelectList)">
                                <option value="">-- Select a Role --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Assign Role
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
