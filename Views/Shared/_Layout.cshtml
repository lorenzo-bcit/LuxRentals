<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - LuxRentals</title>
    <script type="importmap"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/LuxRentals.styles.css" asp-append-version="true"/>
</head>
<body class="bg-surface font-body text-on-surface min-h-screen flex flex-col selection:bg-secondary-container selection:text-on-secondary-container">

<nav class="fixed top-0 w-full z-50 bg-white/80 dark:bg-black/80 backdrop-blur-xl shadow-[0_20px_40px_rgba(0,0,0,0.04)] no-line border-none">
    <div class="flex justify-between items-center max-w-7xl mx-auto px-6 md:px-12 py-6">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-['Noto_Serif'] font-black tracking-tighter text-black dark:text-white hover:opacity-80 transition-opacity">
            LUXRENTALS
        </a>
        <div class="hidden md:flex items-center space-x-6 lg:space-x-12">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="font-['Noto_Serif'] tracking-tighter uppercase text-sm font-bold text-black dark:text-white hover:text-[#C5A059] transition-colors duration-300">Home</a>
            <a asp-area="" asp-controller="Cars" asp-action="Index" class="font-['Noto_Serif'] tracking-tighter uppercase text-sm font-bold text-black dark:text-white hover:text-[#C5A059] transition-colors duration-300">Fleet</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                {
                    <a asp-area="" asp-controller="Booking" asp-action="CustomerList" class="font-['Noto_Serif'] tracking-tighter uppercase text-sm font-bold text-black dark:text-white hover:text-[#C5A059] transition-colors duration-300">Bookings</a>
                }
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="font-['Noto_Serif'] tracking-tighter uppercase text-sm font-bold text-black dark:text-white hover:text-[#C5A059] transition-colors duration-300">Admin</a>
            }
            <partial name="_LoginPartial" />
        </div>
        <a asp-area="" asp-controller="Cars" asp-action="Index" class="hidden sm:inline-block bg-black text-[#C5A059] font-['Noto_Serif'] tracking-tighter uppercase text-sm font-bold px-8 py-3 hover:opacity-70 transition-opacity scale-95 duration-200 ease-in-out text-center">
            Book Now
        </a>
    </div>
</nav>

<main class="grow relative">
    @RenderBody()
</main>

<footer class="bg-black w-full py-20 px-6 md:px-12 mt-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 max-w-7xl mx-auto">
        <div class="flex flex-col space-y-6">
            <div class="text-white font-['Noto_Serif'] font-bold text-xl mb-6">LUXRENTALS</div>
            <p class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white/60 leading-relaxed max-w-xs">
                Curating the world's most exceptional automotive experiences for those who demand perfection in every mile.
            </p>
        </div>
        <div class="flex flex-col space-y-4">
            <span class="font-['Manrope'] uppercase tracking-[0.2rem] text-[10px] text-[#C5A059] font-bold">Quick Links</span>
            <div class="flex flex-col space-y-3">
                <a class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white/40 hover:text-[#C5A059] transition-colors" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white/40 hover:text-[#C5A059] transition-colors" href="#">Terms of Service</a>
                <a class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white/40 hover:text-[#C5A059] transition-colors" href="#">Contact Us</a>
            </div>
        </div>
        <div class="flex flex-col space-y-4">
            <span class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white font-bold">Vancouver HQ</span>
            <p class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white/40">1200 Alberni St, Vancouver<br/>British Columbia, Canada</p>
        </div>
    </div>
    <div class="max-w-7xl mx-auto mt-20 pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center">
        <span class="font-['Manrope'] uppercase tracking-[0.1rem] text-[10px] text-white/60">© 2026 LUXRENTALS VANCOUVER. ALL RIGHTS RESERVED.</span>
        <div class="flex space-x-8 mt-6 md:mt-0">
            <span class="material-symbols-outlined text-white/40 hover:text-white transition-colors cursor-pointer" data-icon="share">share</span>
            <span class="material-symbols-outlined text-white/40 hover:text-white transition-colors cursor-pointer" data-icon="language">language</span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>