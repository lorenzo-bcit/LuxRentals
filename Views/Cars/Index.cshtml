@model LuxRentals.ViewModels.Cars.CarBrowseVm

@{
    ViewData["Title"] = "Fleet Inventory";
    var minBrowseDate = Model.MinBrowseDate;
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12">
    <!-- Progress Indicator -->
    <div class="mb-20 hidden md:block">
        <div class="flex items-center justify-between relative max-w-2xl mx-auto px-4 sm:px-12">
            <div class="absolute top-5 left-0 w-full h-px bg-secondary/30 z-0"></div>
            
            <a asp-controller="Cars" asp-action="Index" class="flex flex-col items-center gap-3 relative z-10 transition-all duration-500 group">
                <div class="bg-surface px-4">
                    <div class="w-10 h-10 rounded-full bg-black text-secondary flex items-center justify-center text-[11px] font-black shadow-[0_0_30px_rgba(197,160,89,0.3)] ring-4 ring-surface group-hover:scale-110 transition-transform">1</div>
                </div>
                <span class="font-label text-[9px] tracking-[0.25rem] uppercase text-on-surface font-black whitespace-nowrap">01. Selection</span>
            </a>
            
            <div class="flex flex-col items-center gap-3 relative z-10 transition-all duration-500">
                <div class="bg-surface px-4">
                    <div class="w-10 h-10 rounded-full border border-outline-variant bg-surface-container-low text-on-surface-variant flex items-center justify-center text-[11px] font-black ring-4 ring-surface opacity-30 grayscale">2</div>
                </div>
                <span class="font-label text-[9px] tracking-[0.25rem] uppercase text-on-surface-variant font-black whitespace-nowrap opacity-30 grayscale">02. Itinerary</span>
            </div>
            
            <div class="flex flex-col items-center gap-3 relative z-10 transition-all duration-500">
                <div class="bg-surface px-4">
                    <div class="w-10 h-10 rounded-full border border-outline-variant bg-surface-container-low text-on-surface-variant flex items-center justify-center text-[11px] font-black ring-4 ring-surface opacity-30 grayscale">3</div>
                </div>
                <span class="font-label text-[9px] tracking-[0.25rem] uppercase text-on-surface-variant font-black whitespace-nowrap opacity-30 grayscale">03. Settlement</span>
            </div>
        </div>
    </div>

    <!-- Page Title & Stats -->
    <div class="flex flex-col md:flex-row justify-between items-center md:items-end text-center md:text-left gap-6 md:gap-0 mb-12 border-b border-outline-variant/20 pb-8" data-reveal>
        <div class="w-full md:w-auto">
            <span class="font-label text-[10px] tracking-[0.3rem] uppercase text-secondary mb-2 block">Selection</span>
            <h1 class="font-headline text-3xl md:text-5xl font-black tracking-tighter uppercase">Vehicles</h1>
        </div>
        <div class="w-full md:w-auto text-center md:text-right">
            <span class="font-label text-[10px] tracking-widest uppercase text-on-surface-variant">Available Vehicles</span>
        </div>
    </div>

    <form method="get" asp-action="Index" autocomplete="off" class="flex flex-col lg:flex-row gap-16">
        <!-- Sidebar Filters -->
        <aside class="w-full lg:w-72 shrink-0">
            <!-- Mobile Filter Toggle -->
            <button type="button" id="filter-toggle-btn"
                    class="w-full flex items-center justify-between gap-3 border border-outline-variant/30 px-6 py-4 mb-4 font-label text-[10px] font-extrabold uppercase tracking-[0.2rem] text-on-surface lg:hidden"
                    aria-expanded="false"
                    aria-controls="filter-sidebar">
                <span>Filters & Dates</span>
                <span class="material-symbols-outlined text-sm" id="filter-toggle-icon">expand_more</span>
            </button>
            <div id="filter-sidebar" class="space-y-12">

            <!-- Dates & Sort -->
            <div class="space-y-6">
                <h3 class="font-label text-[11px] font-extrabold uppercase tracking-[0.2rem] text-on-surface">Reservation Details</h3>
                <div class="space-y-4">
                    <div>
                        <label asp-for="StartDate" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Pick-up</label>
                        <input asp-for="StartDate" type="date"
                               class="ghost-input w-full uppercase tracking-widest text-xs"
                               min="@minBrowseDate"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               onchange="updateDateBounds(this.form); submitIfBothDatesSelected(this.form)" />
                    </div>
                    <div>
                        <label asp-for="EndDate" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Drop-off</label>
                        <input asp-for="EndDate" type="date"
                               class="ghost-input w-full uppercase tracking-widest text-xs"
                               min="@minBrowseDate"
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")"
                               onchange="updateDateBounds(this.form); submitIfBothDatesSelected(this.form)" />
                    </div>
                </div>
            </div>

            <div>
                <div class="space-y-4">
                    <div>
                        <label asp-for="SortBy" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Sort By</label>
                        <select asp-for="SortBy" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer" onchange="submitBrowseForm(this.form)">
                            <option value="price_asc">Price: Low to High</option>
                            <option value="price_desc">Price: High to Low</option>
                            <option value="year_desc">Year: Newest First</option>
                            <option value="year_asc">Year: Oldest First</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Filters -->
            <div>
                <h3 class="font-label text-[11px] font-extrabold uppercase tracking-[0.2rem] mb-6 text-on-surface">Filters</h3>

                <div class="space-y-8">
                    <!-- Max Rate -->
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label asp-for="MaxRate" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Max Daily Rate</label>
                            <span class="font-label text-[10px] font-bold text-secondary" id="maxRateDisplay">CAD @Model.MaxRate?.ToString("0")</span>
                        </div>
                        <input asp-for="MaxRate" type="range" class="w-full accent-[#C5A059]" min="0" max="@Model.MaxSelectableRate.ToString("0")" step="5"
                               oninput="document.getElementById('maxRateDisplay').innerText = 'CAD ' + this.value"
                               onchange="submitBrowseForm(this.form)" />
                    </div>

                    <!-- Min Seats -->
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label asp-for="MinSeats" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Minimum Seats</label>
                            <span class="font-label text-[10px] font-bold text-secondary" id="seatsDisplay">@(Model.MinSeats)</span>
                        </div>
                        <input asp-for="MinSeats" type="range" class="w-full accent-[#C5A059]" min="0" max="@Model.MaxSelectableSeats" step="1"
                               oninput="document.getElementById('seatsDisplay').innerText = this.value"
                               onchange="submitBrowseForm(this.form)" />
                    </div>

                    <!-- Min Luggage -->
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label asp-for="MinLuggage" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Minimum Bags</label>
                            <span class="font-label text-[10px] font-bold text-secondary" id="luggageDisplay">@(Model.MinLuggage)</span>
                        </div>
                        <input asp-for="MinLuggage" type="range" class="w-full accent-[#C5A059]" min="0" max="@Model.MaxSelectableLuggage" step="1"
                               oninput="document.getElementById('luggageDisplay').innerText = this.value"
                               onchange="submitBrowseForm(this.form)" />
                    </div>

                    <!-- Make -->
                    <div>
                        <label asp-for="MakeId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Make</label>
                        <select asp-for="MakeId" asp-items="Model.MakeOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer" onchange="submitBrowseForm(this.form)"></select>
                    </div>

                    <!-- Vehicle Type -->
                    <div>
                        <label asp-for="VehicleClassId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Vehicle Type</label>
                        <select asp-for="VehicleClassId" asp-items="Model.VehicleClassOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer" onchange="submitBrowseForm(this.form)"></select>
                    </div>

                    <!-- Fuel Type -->
                    <div>
                        <label asp-for="FuelTypeId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Fuel Type</label>
                        <select asp-for="FuelTypeId" asp-items="Model.FuelTypeOptions" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer" onchange="submitBrowseForm(this.form)"></select>
                    </div>

                    <!-- Transmission Type -->
                    <div>
                        <label asp-for="TransmissionType" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-2 block">Transmission</label>
                        <select asp-for="TransmissionType" class="ghost-input w-full uppercase tracking-widest text-xs cursor-pointer" onchange="submitBrowseForm(this.form)">
                            <option value="">Any</option>
                            <option value="1">Automatic</option>
                            <option value="0">Manual</option>
                        </select>
                    </div>

                    <!-- Clear Filters -->
                    <div class="pt-4 border-t border-outline-variant/20">
                        <a asp-action="Index" class="border border-on-surface text-center block w-full uppercase tracking-widest font-bold text-[10px] py-4 hover:bg-on-surface hover:text-white transition-colors">Clear Filters</a>
                    </div>
                </div>
            </div>
            </div>
        </aside>

        <!-- Vehicle Grid -->
        <div class="grow">
            @if (Model.Cars.Count == 0)
            {
                <div class="bg-surface-container-high p-12 text-center border border-outline-variant/20">
                    <span class="material-symbols-outlined text-6xl text-secondary mb-4">no_crash</span>
                    <h3 class="font-headline text-2xl font-bold mb-2">No Vehicles Found</h3>
                    <p class="font-label text-sm text-on-surface-variant max-w-md mx-auto">@Model.EmptyStateMessage</p>
                    <a asp-action="Index" class="mt-8 bg-black text-white px-8 py-3 uppercase tracking-widest text-[10px] font-bold shadow-xl inline-block hover:bg-secondary transition-colors">Reset Filters</a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 md:gap-8">
                    @foreach (var car in Model.Cars)
                    {
                        <div class="group bg-surface-container-lowest flex flex-col h-full border border-outline-variant/10 hover:border-secondary/30 transition-all duration-500 hover:shadow-[0_30px_60px_rgba(0,0,0,0.12)] overflow-hidden relative">
                            
                            <!-- Gold Accent Line -->
                            <div class="absolute top-0 left-0 w-full h-[2px] bg-secondary z-20 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-700"></div>

                            <!-- Image Block -->
                            <!-- Fixed aspect ratio image frame — enforces uniform size regardless of source dimensions -->
                            <div class="relative w-full aspect-video overflow-hidden shrink-0">
                                @if (!string.IsNullOrWhiteSpace(car.Thumbnail))
                                {
                                    <img class="absolute inset-0 w-full h-full object-cover object-bottom group-hover:scale-105 transition-transform duration-700" src="@car.Thumbnail" alt="@car.Title" />
                                    <!-- Bottom gradient fade for clean text reading -->
                                    <div class="absolute inset-0 bg-linear-to-t from-black/60 via-black/5 to-transparent z-10"></div>
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        <span class="material-symbols-outlined text-4xl text-white/20">directions_car</span>
                                    </div>
                                }

                                <!-- Badges pinned over the image -->
                                <div class="absolute bottom-3 left-3 z-20 flex items-center gap-2">
                                    <span class="bg-secondary text-black text-[8px] font-black uppercase tracking-widest px-2 py-1">@car.Subtitle</span>
                                    <span class="bg-black/60 backdrop-blur-sm text-white text-[8px] font-bold uppercase tracking-widest px-2 py-1">@car.Transmission</span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-5 md:p-6 flex flex-col grow">
                                <!-- Title -->
                                <div class="mb-4 grow">
                                    <h3 class="font-headline text-base md:text-lg font-black tracking-tight leading-snug uppercase">@car.Title</h3>
                                </div>

                                <!-- Specs Row -->
                                <div class="grid grid-cols-3 gap-2 mb-5 border-t border-outline-variant/20 pt-4">
                                    <div class="text-center">
                                        <span class="font-label text-[8px] uppercase tracking-widest text-on-surface-variant block mb-0.5">Fuel</span>
                                        <span class="font-body text-[10px] font-bold uppercase">@car.FuelType</span>
                                    </div>
                                    <div class="text-center border-x border-outline-variant/20">
                                        <span class="font-label text-[8px] uppercase tracking-widest text-on-surface-variant block mb-0.5">Seats</span>
                                        <span class="font-body text-[10px] font-bold uppercase">@car.Seats Pax</span>
                                    </div>
                                    <div class="text-center">
                                        <span class="font-label text-[8px] uppercase tracking-widest text-on-surface-variant block mb-0.5">Luggage</span>
                                        <span class="font-body text-[10px] font-bold uppercase">@car.Luggage Bags</span>
                                    </div>
                                </div>

                                <!-- Price + CTA -->
                                <div class="flex items-center justify-between gap-3 mt-auto">
                                    <div class="flex items-baseline gap-1">
                                        <span class="font-headline text-xl md:text-2xl font-black text-secondary">@car.DailyRate.ToString("0")</span>
                                        <span class="font-label text-[9px] uppercase font-bold text-on-surface-variant">CAD / day</span>
                                    </div>
                                    <a asp-controller="Booking"
                                       asp-action="Create"
                                       asp-route-carId="@car.CarId"
                                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                       class="shrink-0 bg-black text-white px-5 py-2.5 font-label text-[9px] font-bold uppercase tracking-widest hover:bg-secondary hover:text-black transition-colors duration-300">
                                        Select
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="mt-20 flex justify-center items-center gap-6">
                        <button type="submit" name="Page" value="@(Model.Page - 1)" class="w-12 h-12 rounded-full border border-on-surface flex items-center justify-center hover:bg-on-surface hover:text-white transition-colors disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-on-surface" @(Model.HasPreviousPage ? "" : "disabled") aria-disabled="@(!Model.HasPreviousPage)">
                            <span class="material-symbols-outlined text-sm">arrow_back_ios_new</span>
                        </button>

                        <span class="font-label text-[10px] uppercase tracking-[0.2rem] font-bold text-on-surface">Page @Model.Page of @Model.TotalPages</span>

                        <button type="submit" name="Page" value="@(Model.Page + 1)" class="w-12 h-12 rounded-full border border-on-surface flex items-center justify-center hover:bg-on-surface hover:text-white transition-colors disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-on-surface" @(Model.HasNextPage ? "" : "disabled") aria-disabled="@(!Model.HasNextPage)">
                            <span class="material-symbols-outlined text-sm">arrow_forward_ios</span>
                        </button>
                    </div>
                }
            }
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const browseScrollStorageKey = 'cars-index-scroll-y';
        const hasBrowseResults = @Model.Cars.Count.ToString().ToLowerInvariant();

        function addDays(dateString, days) {
            if(!dateString) return;
            const [year, month, day] = dateString.split('-').map(Number);
            const date = new Date(Date.UTC(year, month - 1, day));
            date.setUTCDate(date.getUTCDate() + days);
            return date.toISOString().split('T')[0];
        }

        function rememberBrowseScroll() {
            sessionStorage.setItem(browseScrollStorageKey, String(window.scrollY));
        }

        function submitBrowseForm(form) {
            rememberBrowseScroll();
            form.submit();
        }

        function updateDateBounds(form) {
            const start = form.querySelector('[name=StartDate]');
            const end = form.querySelector('[name=EndDate]');

            if (start.value) {
                end.min = addDays(start.value, 1);
            } else {
                end.min = start.min;
            }

            if (end.value) {
                start.max = addDays(end.value, -1);
            } else {
                start.removeAttribute('max');
            }
        }

        function submitIfBothDatesSelected(form) {
            const start = form.querySelector('[name=StartDate]').value;
            const end = form.querySelector('[name=EndDate]').value;

            if (start && end) {
                submitBrowseForm(form);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('form[method="get"]');
            const dateInputs = form?.querySelectorAll('input[type="date"]') ?? [];
            const savedScrollPosition = sessionStorage.getItem(browseScrollStorageKey);

            if (savedScrollPosition !== null) {
                sessionStorage.removeItem(browseScrollStorageKey);

                if (hasBrowseResults) {
                    window.requestAnimationFrame(() => {
                        window.scrollTo(0, Number(savedScrollPosition));
                    });
                } else {
                    window.requestAnimationFrame(() => {
                        window.scrollTo(0, 0);
                    });
                }
            }

            if (form) {
                updateDateBounds(form);
                form.addEventListener('submit', rememberBrowseScroll);
            }

            dateInputs.forEach(input => {
                input.addEventListener('keydown', event => {
                    if (
                        event.key === 'Tab' ||
                        event.key === 'Enter' ||
                        event.key === 'Escape' ||
                        event.key.startsWith('Arrow')
                    ) {
                        return;
                    }

                    event.preventDefault();
                });
            });
        });
    </script>
}
