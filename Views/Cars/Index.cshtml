@model LuxRentals.ViewModels.Cars.CarBrowseVm

@{
    ViewData["Title"] = "Cars";
    var minBrowseDate = Model.MinBrowseDate;
}

<section class="container py-4">
    <form method="get" asp-action="Index" autocomplete="off">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 p-3 bg-light border rounded">
            <h1 class="cars-toolbar-title">Choose your options below</h1>
            <div class="cars-sort">
                <label asp-for="SortBy" class="form-label">Sort by</label>
                <select asp-for="SortBy" class="form-select" onchange="this.form.submit()">
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="year_desc">Year: Newest First</option>
                    <option value="year_asc">Year: Oldest First</option>
                </select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label">Pick-up</label>
                <input asp-for="StartDate"
                       type="date"
                       class="form-control"
                       min="@minBrowseDate"
                       value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       onchange="updateDateBounds(this.form); submitIfBothDatesSelected(this.form)" />
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label">Drop-off</label>
                <input asp-for="EndDate"
                       type="date"
                       class="form-control"
                       min="@minBrowseDate"
                       value="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       onchange="updateDateBounds(this.form); submitIfBothDatesSelected(this.form)" />
            </div>
        </div>
        <div class="row g-3">
            <aside class="col-lg-3">
                <div class="card p-3 row-gap-2">
                    <h2>Filters</h2>

                    <div class="cars-filter-block">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="MaxRate" class="form-label mb-0">Max daily rate</label>
                            <span class="fw-semibold" id="maxRateDisplay">CAD @Model.MaxRate?.ToString("0")</span>
                        </div>
                        <input asp-for="MaxRate"
                               type="range"
                               class="form-range mt-2"
                               min="0"
                               max="@Model.MaxSelectableRate.ToString("0")"
                               step="5"
                               oninput="document.getElementById('maxRateDisplay').innerText = 'CAD ' + this.value"
                               onchange="this.form.submit()" />
                    </div>

                    <div class="cars-filter-block">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="MinSeats" class="form-label mb-0">Minimum seats</label>
                            <span class="fw-semibold" id="seatsDisplay">@(Model.MinSeats)</span>
                        </div>
                        <input asp-for="MinSeats"
                               type="range"
                               class="form-range mt-2"
                               min="0"
                               max="@Model.MaxSelectableSeats"
                               step="1"
                               oninput="document.getElementById('seatsDisplay').innerText = this.value"
                               onchange="this.form.submit()" />
                    </div>

                    <div class="cars-filter-block">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="MinLuggage" class="form-label mb-0">Minimum luggage</label>
                            <span class="fw-semibold" id="luggageDisplay">@(Model.MinLuggage)</span>
                        </div>
                        <input asp-for="MinLuggage"
                               type="range"
                               class="form-range mt-2"
                               min="0"
                               max="@Model.MaxSelectableLuggage"
                               step="1"
                               oninput="document.getElementById('luggageDisplay').innerText = this.value"
                               onchange="this.form.submit()" />
                    </div>

                    <div class="cars-filter-block">
                        <label asp-for="MakeId" class="form-label fw-semibold">Make</label>
                        <select asp-for="MakeId" asp-items="Model.MakeOptions" class="form-select" onchange="this.form.submit()"></select>
                    </div>

                    <div class="cars-filter-block">
                        <label asp-for="VehicleClassId" class="form-label fw-semibold">Vehicle Type</label>
                        <select asp-for="VehicleClassId" asp-items="Model.VehicleClassOptions" class="form-select" onchange="this.form.submit()"></select>
                    </div>

                    <div class="cars-filter-block">
                        <label asp-for="FuelTypeId" class="form-label fw-semibold">Fuel Type</label>
                        <select asp-for="FuelTypeId" asp-items="Model.FuelTypeOptions" class="form-select" onchange="this.form.submit()"></select>
                    </div>

                    <div class="cars-filter-block">
                        <label asp-for="TransmissionType" class="form-label fw-semibold">Transmission</label>
                        <select asp-for="TransmissionType" class="form-select" onchange="this.form.submit()">
                            <option value="">Any</option>
                            <option value="1">Automatic</option>
                            <option value="0">Manual</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </div>
            </aside>

            <div class="col-lg-9 d-flex flex-column gap-3">
                @if (Model.Cars.Count == 0)
                {
                    <div class="alert alert-secondary">@Model.EmptyStateMessage</div>
                }
                else
                {
                    @foreach (var car in Model.Cars)
                    {
                        <div class="card p-3">
                            <div class="row align-items-center g-3">
                                <div class="col-auto">
                                    <div class="bg-light border d-flex justify-content-center align-items-center overflow-hidden"
                                         style="width: 150px; aspect-ratio: 3 / 2;">
                                        @if (!string.IsNullOrWhiteSpace(car.Thumbnail))
                                        {
                                            <img src="@car.Thumbnail"
                                                 alt="@car.Subtitle"
                                                 class="img-fluid"
                                                 style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No image</span>
                                        }
                                    </div>
                                </div>

                                <div class="col">
                                    <h3 class="mb-1">@car.Title</h3>
                                    <p class="mb-1 fw-semibold">@car.Subtitle</p>
                                    <p class="mb-1 text-muted">
                                        @car.Transmission • @car.Seats person • @car.Luggage bags • @car.FuelType
                                    </p>
                                </div>

                                <div class="col-auto text-end">
                                    <div class="fw-semibold">Daily Rate</div>
                                    <div class="text-muted small">CAD</div>
                                    <div class="fs-3 fw-bold">@car.DailyRate.ToString("0.00")</div>
                                    <a asp-controller="Booking"
                                       asp-action="Create"
                                       asp-route-carId="@car.CarId"
                                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                       class="btn btn-secondary btn-sm mt-1">
                                        Book
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }

                <nav aria-label="Cars pages" class="cars-pagination align-self-center">
                    <button type="submit"
                            name="Page"
                            value="@(Model.Page - 1)"
                            class="btn btn-outline-dark rounded-circle @(Model.HasPreviousPage ? "" : "disabled")"
                            aria-disabled="@(!Model.HasPreviousPage)"
                            @(Model.HasPreviousPage ? null : "disabled")>
                        &lt;
                    </button>

                    <span class="cars-page-label mx-lg-2">Page @Model.Page of @Model.TotalPages</span>

                    <button type="submit"
                            name="Page"
                            value="@(Model.Page + 1)"
                            class="btn btn-outline-dark rounded-circle @(Model.HasNextPage ? "" : "disabled")"
                            aria-disabled="@(!Model.HasNextPage)"
                            @(Model.HasNextPage ? null : "disabled")>
                        &gt;
                    </button>
                </nav>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addDays(dateString, days) {
            const [year, month, day] = dateString.split('-').map(Number);
            const date = new Date(Date.UTC(year, month - 1, day));
            date.setUTCDate(date.getUTCDate() + days);
            return date.toISOString().split('T')[0];
        }

        function updateDateBounds(form) {
            const start = form.querySelector('[name=StartDate]');
            const end = form.querySelector('[name=EndDate]');

            if (start.value) {
                end.min = addDays(start.value, 1);
            } else {
                end.min = start.min;
            }

            if (end.value) {
                start.max = addDays(end.value, -1);
            } else {
                start.removeAttribute('max');
            }
        }

        function submitIfBothDatesSelected(form) {
            const start = form.querySelector('[name=StartDate]').value;
            const end = form.querySelector('[name=EndDate]').value;

            if (start && end) {
                form.submit();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('form[method="get"]');
            const dateInputs = form?.querySelectorAll('input[type="date"]') ?? [];

            if (form) {
                updateDateBounds(form);
            }

            dateInputs.forEach(input => {
                input.addEventListener('keydown', event => {
                    event.preventDefault();
                });
            });
        });
    </script>
}
