@{
    ViewData["Title"] = "Checkout";
}

<script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PayPalClientId&currency=CAD"></script>

<div class="checkout-page">
    <div class="checkout-header mb-4">
        <h1><i class="bi bi-credit-card-fill"></i> Checkout</h1>
        <p class="text-muted">Complete your booking payment</p>
    </div>

    <div id="payment-error" class="alert alert-danger d-none"></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Booking Summary -->
        <div class="col-md-6">
            <div class="card admin-card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Booking Summary</h5>
                    <hr />
                    <p><strong>Start Date:</strong> @ViewBag.StartDate</p>
                    <p><strong>End Date:</strong> @ViewBag.EndDate</p>
                    <p><strong>Total Price:</strong> <span class="text-success fw-bold">$@ViewBag.Price CAD</span></p>
                </div>
            </div>
        </div>

        <!-- Payment Section -->
        <div class="col-md-6">
            <div class="card admin-card shadow-sm h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-paypal display-4 text-primary mb-3"></i>
                    <h5 class="card-title">Pay with PayPal</h5>
                    <p class="text-muted">Secure payment processed through PayPal.</p>
                    <hr />
                    <div id="paypal-button-container"></div>
                    @Html.AntiForgeryToken()
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    const orderId = "@ViewBag.OrderId";

    paypal.Buttons({
        createOrder: (data, actions) => {
            return orderId;
        },
        onApprove: (data, actions) => {
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            const errorBox = document.getElementById("payment-error");
            errorBox.classList.add("d-none");
            errorBox.innerText = "";

            return fetch("/Payment/Capture", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify({ orderId: data.orderID })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location = data.redirectUrl;
                } else {
                    errorBox.classList.remove("d-none");
                    errorBox.innerText = data.message || "Payment failed.";
                    if (data.redirectUrl) window.location = data.redirectUrl;
                }
            })
            .catch(err => {
                errorBox.classList.remove("d-none");
                errorBox.innerText = "Unexpected error during payment.";
                console.error(err);
            });
        },
        onError: (err) => {
            const errorBox = document.getElementById("payment-error");
            errorBox.classList.remove("d-none");
            errorBox.innerText = "PayPal error. Please try again.";
            console.error(err);
        }
    }).render("#paypal-button-container");
</script>