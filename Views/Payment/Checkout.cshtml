@{
    ViewData["Title"] = "Luxury Checkout";
}

<script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PayPalClientId&currency=CAD"></script>

<main class="pt-40 pb-32 max-w-7xl mx-auto px-6 md:px-12 bg-surface">
     <!-- Progress Indicator -->
    <div class="mb-16">
        <div class="flex items-center justify-between relative max-w-3xl mx-auto">
            <div class="absolute top-1/2 left-0 w-full h-[1px] bg-outline-variant/30 -z-10"></div>
            <div class="flex flex-col items-center gap-2 bg-surface px-4">
                <span class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-[10px] font-bold bg-white">1</span>
                <span class="font-label text-[10px] tracking-[0.15rem] uppercase text-on-surface-variant hidden sm:block">Pick a Vehicle</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-surface px-4 opacity-40">
                <span class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-[10px] font-bold bg-white">2</span>
                <span class="font-label text-[10px] tracking-[0.15rem] uppercase text-on-surface-variant hidden sm:block">Pick a Date</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-surface px-4">
                <span class="w-10 h-10 rounded-full bg-on-secondary-fixed text-secondary-fixed flex items-center justify-center text-[10px] font-bold scale-110 shadow-xl border border-secondary">3</span>
                <span class="font-label text-[10px] tracking-[0.15rem] uppercase text-on-surface font-black hidden sm:block">Reserve</span>
            </div>
        </div>
    </div>
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-8">
        <div>
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Secure Transaction</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-4">Final Statement</h1>
            <p class="font-body text-xs text-on-surface-variant uppercase tracking-widest opacity-80">Reference ID: @ViewBag.OrderId</p>
        </div>
        <div class="text-right">
             <div class="flex items-center gap-3 text-secondary justify-end mb-2">
                <span class="material-symbols-outlined text-sm">lock</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-widest">Encrypted Checkout</span>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold animate-pulse" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
        
        <!-- Statement Details -->
        <div class="space-y-12">
            <div>
                <h3 class="font-label text-xs font-black uppercase tracking-[0.2rem] mb-12 flex items-center gap-4">
                    <span class="w-8 h-px bg-on-surface/20"></span>
                    Reservation Summary
                </h3>
                
                <div class="space-y-8">
                    <!-- Dates -->
                    <div class="grid grid-cols-2 gap-12 border-b border-outline-variant/10 pb-8">
                        <div>
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block mb-2">Collection</span>
                            <span class="font-headline text-xl font-bold uppercase">@ViewBag.StartDate</span>
                        </div>
                        <div>
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block mb-2">Return</span>
                            <span class="font-headline text-xl font-bold uppercase">@ViewBag.EndDate</span>
                        </div>
                    </div>

                    <!-- Financials -->
                    <div class="space-y-6">
                        <div class="flex justify-between items-center text-on-surface-variant">
                            <span class="font-body text-xs uppercase tracking-widest">Base Rate Agreement</span>
                            <span class="font-body text-xs font-bold">$@ViewBag.Price CAD</span>
                        </div>
                        <div class="flex justify-between items-center text-on-surface-variant">
                            <span class="font-body text-xs uppercase tracking-widest">Embassy Surcharge</span>
                            <span class="font-body text-xs font-bold">$0.00 CAD</span>
                        </div>
                        <div class="pt-6 border-t border-outline-variant text-on-surface flex justify-between items-baseline font-headline">
                            <span class="text-[10px] uppercase font-black tracking-widest">Guaranteed Total</span>
                            <div class="flex items-baseline gap-2">
                                <span class="text-xs font-bold text-on-surface-variant">CAD</span>
                                <span class="text-4xl font-black text-secondary">$@ViewBag.Price</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-surface-container-low p-8 border border-outline-variant/10 text-center">
                <p class="font-body text-[10px] uppercase tracking-widest text-on-surface-variant leading-loose">
                    By clicking to pay, you acknowledge our concierge policy regarding vehicle collection and the 24-hour maintenance window.
                </p>
            </div>
        </div>

        <!-- Payment Processing -->
        <div class="lg:sticky lg:top-48">
            <div class="bg-surface-container-lowest p-12 shadow-[0_45px_100px_rgba(0,0,0,0.08)] border border-outline-variant/10 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-bl-full transform translate-x-12 -translate-y-12"></div>
                
                <div class="relative z-10 space-y-12">
                     <div class="flex flex-col items-center gap-6">
                        <div class="w-20 h-20 bg-black flex items-center justify-center rounded-full mb-4 shadow-xl">
                            <span class="material-symbols-outlined text-white text-3xl">contactless</span>
                        </div>
                        <div class="text-center">
                            <h3 class="font-headline text-2xl font-black uppercase tracking-tight mb-2">Instant Settlement</h3>
                            <p class="font-body text-xs uppercase tracking-widest text-on-surface-variant">Choose your preferred methodology</p>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div id="paypal-button-container" class="min-h-[50px]"></div>
                        
                        <div class="flex items-center gap-4 text-outline justify-center opacity-40 grayscale group-hover:grayscale-0 transition-all">
                             <span class="material-symbols-outlined">shield</span>
                             <span class="font-label text-[9px] uppercase tracking-widest font-bold">Encrypted via PayPal Network</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

@Html.AntiForgeryToken()

<script>
    paypal.Buttons({

        createOrder: function (data, actions) {
            return "@ViewBag.OrderId";
        },

        onApprove: function (data, actions) {

            document.getElementById("paypal-button-container").innerHTML = "<p>Processing payment...</p>";

            fetch("/Payment/Capture", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    orderId: data.orderID
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location = data.redirectUrl;
                } else {
                    alert(data.message || "Payment failed.");
                }
            })
            .catch(err => {
                console.error(err);
                alert("Payment failed. Please try again.");
            });
        },

        onError: function (err) {
            console.error("PayPal error:", err);
            alert("Payment failed. Please try again.");
        }

    }).render('#paypal-button-container');
</script>