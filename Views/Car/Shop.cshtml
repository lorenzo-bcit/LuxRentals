@{
    ViewData["Title"] = "Shop - Available Vehicles";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">Available Vehicles</h1>
            <p class="lead">Browse and book your perfect ride</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        <!-- HARDCODED CAR 1 -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="bi bi-car-front-fill text-white" style="font-size: 4rem;"></i>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Honda Accord</h5>
                    <p class="text-muted">
                        <small>2023 • Silver • Automatic</small>
                    </p>
                    <ul class="list-unstyled small mb-3">
                        <li><i class="bi bi-people-fill text-primary"></i> 5 Passengers</li>
                        <li><i class="bi bi-bag-fill text-primary"></i> 3 Bags</li>
                        <li><i class="bi bi-fuel-pump-fill text-primary"></i> Gasoline</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-success">Available</span>
                        <h4 class="text-primary mb-0">$59.99<small class="text-muted">/day</small></h4>
                    </div>
                    <a asp-controller="Booking" asp-action="Create" asp-route-carId="1"
                       class="btn btn-primary w-100">
                        <i class="bi bi-calendar-plus"></i> Book Now
                    </a>
                </div>
            </div>
        </div>

        <!-- HARDCODED CAR 2 -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="bi bi-car-front-fill text-white" style="font-size: 4rem;"></i>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Toyota Camry</h5>
                    <p class="text-muted">
                        <small>2024 • White • Automatic</small>
                    </p>
                    <ul class="list-unstyled small mb-3">
                        <li><i class="bi bi-people-fill text-primary"></i> 5 Passengers</li>
                        <li><i class="bi bi-bag-fill text-primary"></i> 4 Bags</li>
                        <li><i class="bi bi-fuel-pump-fill text-primary"></i> Hybrid</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-success">Available</span>
                        <h4 class="text-primary mb-0">$69.99<small class="text-muted">/day</small></h4>
                    </div>
                    <a asp-controller="Booking" asp-action="Create" asp-route-carId="2"
                       class="btn btn-primary w-100">
                        <i class="bi bi-calendar-plus"></i> Book Now
                    </a>
                </div>
            </div>
        </div>

        <!-- HARDCODED CAR 3 -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="bi bi-truck-front-fill text-white" style="font-size: 4rem;"></i>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Ford F-150</h5>
                    <p class="text-muted">
                        <small>2023 • Blue • Automatic</small>
                    </p>
                    <ul class="list-unstyled small mb-3">
                        <li><i class="bi bi-people-fill text-primary"></i> 5 Passengers</li>
                        <li><i class="bi bi-bag-fill text-primary"></i> 2 Bags</li>
                        <li><i class="bi bi-fuel-pump-fill text-primary"></i> Gasoline</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-success">Available</span>
                        <h4 class="text-primary mb-0">$89.99<small class="text-muted">/day</small></h4>
                    </div>
                    <a asp-controller="Booking" asp-action="Create" asp-route-carId="3"
                       class="btn btn-primary w-100">
                        <i class="bi bi-calendar-plus"></i> Book Now
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>