@model LuxRentals.ViewModels.Roles.ProfileVm
@{
    ViewData["Title"] = "Customer Dossier";
    bool isAdmin = User.IsInRole("Admin");
}

<main class="pt-32 pb-40 max-w-5xl mx-auto px-6 md:px-12">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-12">
        <div class="max-w-xl">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Personal Information</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-6">Client Dossier</h1>
            <p class="font-body text-[10px] text-on-surface-variant uppercase tracking-widest leading-loose">Comprehensive profile data and credentials for @Model.FirstName @Model.LastName.</p>
        </div>
        <div class="text-right">
             <div class="flex items-center gap-3 text-secondary justify-end mb-2">
                <span class="material-symbols-outlined text-sm">verified</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-widest">Verified Identity</span>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-12 p-6 bg-secondary-container/10 border-l-4 border-secondary text-secondary text-xs uppercase tracking-widest font-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold">@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="mb-12 p-6 bg-surface-container-high border-l-4 border-secondary text-on-surface-variant text-xs uppercase tracking-widest font-bold">@TempData["Info"]</div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        <!-- Profile Sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-surface-container-lowest p-12 border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] text-center relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-secondary"></div>
                <div class="w-32 h-32 bg-surface-container mx-auto rounded-full flex items-center justify-center border border-outline-variant/30 mb-8">
                     <span class="material-symbols-outlined text-5xl text-on-surface-variant">person</span>
                </div>
                <h2 class="font-headline text-2xl font-black uppercase tracking-tight mb-2">@Model.FirstName @Model.LastName</h2>
                <span class="font-label text-[10px] uppercase tracking-[0.2rem] text-secondary font-bold block mb-8">Executive Client</span>
                
                <div class="pt-8 border-t border-outline-variant/20 flex flex-col gap-4">
                     <a asp-controller="Booking" asp-action="MyBookings" class="block w-full border border-on-surface/20 text-center py-4 font-label text-[10px] font-bold uppercase tracking-[0.2rem] hover:bg-on-surface hover:text-white transition-all shadow-xl">
                        Manage Bookings
                    </a>
                     <a asp-action="Edit" asp-route-id="@Model.PkCustomerId" class="block w-full bg-black text-white text-center py-4 font-label text-[10px] font-bold uppercase tracking-[0.2rem] hover:bg-secondary transition-colors shadow-2xl">
                        Modify Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- Detail Registry -->
        <div class="lg:col-span-2">
            <div class="bg-surface-container-lowest p-12 border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)]">
                <h3 class="font-label text-xs font-black uppercase tracking-[0.4rem] text-on-surface-variant mb-12 flex items-center gap-6">
                    <span class="w-12 h-px bg-on-surface/20"></span>
                    Identity Specifications
                </h3>

                <div class="space-y-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                        <div class="space-y-2">
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">First Name</span>
                            <p class="font-headline text-xl font-bold uppercase">@Model.FirstName</p>
                        </div>
                        <div class="space-y-2">
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Last Name</span>
                            <p class="font-headline text-xl font-bold uppercase">@Model.LastName</p>
                        </div>
                    </div>

                    <div class="pt-10 border-t border-outline-variant/10">
                         <div class="space-y-2">
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Email</span>
                            <p class="font-headline text-xl font-bold lowercase tracking-tight">@Model.Email</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 pt-10 border-t border-outline-variant/10">
                        <div class="space-y-2">
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Phone Number</span>
                            <p class="font-headline text-xl font-bold uppercase">@Model.PhoneNumber</p>
                        </div>
                        <div class="space-y-2">
                            <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Driver's License</span>
                            <p class="font-headline text-xl font-bold uppercase tracking-widest">
                                @(Model.DriverLicenceNo.Length > 4 ? "####-" + Model.DriverLicenceNo.Substring(Model.DriverLicenceNo.Length - 4) : Model.DriverLicenceNo)
                            </p>
                            @if (isAdmin) 
                            {
                                <span class="font-body text-[10px] text-on-surface-variant opacity-60">Complete: @Model.DriverLicenceNo</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-16 flex justify-start gap-8">
                    @if (isAdmin)
                    {
                        <a asp-action="Index" asp-controller="UserRole" asp-area="Admin" class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all">
                             <span class="material-symbols-outlined text-sm">group</span>
                             Registry
                        </a>            
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Home" class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all">
                            <span class="material-symbols-outlined text-sm">home</span>
                            Home
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</main>