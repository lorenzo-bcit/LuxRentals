@model IEnumerable<LuxRentals.ViewModels.Roles.ProfileVm>
@{
    ViewData["Title"] = "Customer Registry";
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12 bg-surface flex flex-col min-h-screen">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-end gap-12">
        <div class="max-w-xl">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Enterprise Management</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-6">Customer Registry</h1>
            <p class="font-body text-[10px] text-on-surface-variant uppercase tracking-widest leading-loose">A specialized ledger of verified executive clients and their validated credentials.</p>
        </div>
        <div class="text-right">
             <div class="flex items-center gap-3 text-secondary justify-end mb-2">
                <span class="material-symbols-outlined text-sm">person_check</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-widest">Client Dossiers Only</span>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-12 p-6 bg-secondary-container/10 border-l-4 border-secondary text-secondary text-xs uppercase tracking-widest font-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold">@TempData["Error"]</div>
    }

    <div class="bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
        <table class="w-full text-left font-body text-xs border-collapse">
            <thead>
                <tr class="border-b border-outline-variant/20 bg-surface-container-low/30 font-label text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                    <th class="py-8 px-10">Client Identity</th>
                    <th class="py-8 px-10">Verification</th>
                    <th class="py-8 px-10">Personal Information</th>
                    <th class="py-8 px-10 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10">
                @if (Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr class="group hover:bg-surface-container-low/20 transition-colors duration-500">
                            <td class="py-8 px-10">
                                <div class="flex items-center gap-6">
                                    <div class="w-12 h-12 bg-surface-container flex items-center justify-center border border-outline-variant/20 rounded-full group-hover:bg-black group-hover:text-white transition-all duration-500">
                                        <span class="material-symbols-outlined text-sm">verified_user</span>
                                    </div>
                                    <div>
                                        <span class="font-headline font-bold text-lg uppercase tracking-tight block">@customer.FirstName @customer.LastName</span>
                                        <span class="font-label text-[8px] uppercase tracking-tighter text-on-surface-variant opacity-60">ID: #@customer.PkCustomerId</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-8 px-10">
                                <div class="space-y-1">
                                    <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block mb-1">License</span>
                                    <span class="font-headline font-bold text-on-surface uppercase tracking-widest">
                                        @(customer.DriverLicenceNo.Length > 4 ? "####-" + customer.DriverLicenceNo.Substring(customer.DriverLicenceNo.Length - 4) : customer.DriverLicenceNo)
                                    </span>
                                </div>
                            </td>
                            <td class="py-8 px-10">
                                <div class="space-y-1">
                                    <span class="font-body text-[10px] text-on-surface block lowercase tracking-tight">@customer.Email</span>
                                    <span class="font-body text-[10px] text-on-surface-variant lowercase tracking-widest">@customer.PhoneNumber</span>
                                </div>
                            </td>
                            <td class="py-8 px-10 text-right">
                                <div class="flex justify-end gap-4">
                                    <a asp-action="Edit" asp-route-id="@customer.PkCustomerId" class="inline-flex items-center justify-center py-3 px-6 border border-on-surface/20 text-on-surface font-label text-[9px] font-bold uppercase tracking-widest hover:bg-on-surface hover:text-white transition-all" title="Modify dossier">
                                        Modify
                                    </a>
                                    <a asp-action="Details" asp-route-id="@customer.Email" class="inline-flex items-center justify-center py-3 px-6 bg-black text-white font-label text-[9px] font-bold uppercase tracking-widest hover:bg-secondary transition-all" title="View details">
                                        Inspect
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-24 text-center">
                            <span class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">No client dossiers identified in system.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-12 flex justify-start">
        <a asp-area="Admin" asp-controller="AdminProfile" asp-action="Index" class="flex items-center gap-3 border border-on-surface/20 px-8 py-4 font-label text-[10px] font-bold uppercase tracking-widest hover:border-on-surface transition-all">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Dashboard
        </a>
    </div>
</main>