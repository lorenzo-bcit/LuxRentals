@model IEnumerable<LuxRentals.ViewModels.Bookings.CustomerListViewModel>

@{
    ViewData["Title"] = "Customer Bookings Registry";
}

<main class="pt-32 pb-24 max-w-7xl mx-auto px-6 md:px-12 bg-surface">
    <!-- Header -->
    <div class="mb-16 border-b border-outline-variant/20 pb-12 flex flex-col md:flex-row justify-between items-center md:items-end text-center md:text-left gap-12">
        <div class="w-full md:w-auto max-w-xl">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-2 block">Management</span>
            <h1 class="font-headline text-3xl md:text-5xl font-black tracking-tighter uppercase mb-6">Customer Bookings</h1>
            <p class="font-body text-[10px] text-on-surface-variant uppercase tracking-widest leading-loose">List of customers and their active bookings.</p>
        </div>
        <div class="w-full md:w-auto text-center md:text-right mt-6 md:mt-0">
             <div class="flex items-center justify-center md:justify-end gap-3 text-secondary mb-2">
                <span class="material-symbols-outlined text-sm">assignment_ind</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-widest">Directory</span>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-12 p-6 bg-error-container/10 border-l-4 border-error text-error text-xs uppercase tracking-widest font-bold" role="alert">@TempData["Error"]</div>
    }

    <div class="table-scroll bg-surface-container-lowest border border-outline-variant/10 shadow-[0_45px_100px_rgba(0,0,0,0.06)] overflow-hidden">
        <table class="w-full text-left font-body text-xs border-collapse">
            <thead>
                <tr class="border-b border-outline-variant/20 bg-surface-container-low/30 font-label text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                    <th class="py-8 px-10">Client Identity</th>
                    <th class="py-8 px-10 col-hide-mobile">Communication Channel</th>
                    <th class="py-8 px-10 text-center col-hide-mobile">Historical Vol.</th>
                    <th class="py-8 px-10 text-center">Active Status</th>
                    <th class="py-8 px-10 text-center">Bookings</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10">
                @if (Model != null && Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr class="group hover:bg-surface-container-low/20 transition-colors duration-500">
                            <td class="py-8 px-10">
                                <div class="flex items-center gap-6">
                                    <div class="w-12 h-12 bg-surface-container flex items-center justify-center border border-outline-variant/20 rounded-full group-hover:bg-black group-hover:text-white transition-all duration-500">
                                        <span class="material-symbols-outlined text-sm">face</span>
                                    </div>
                                    <span class="font-headline font-bold text-lg uppercase tracking-tight">@customer.FirstName @customer.LastName</span>
                                </div>
                            </td>
                            <td class="py-8 px-10 font-body text-xs lowercase tracking-widest text-on-surface-variant group-hover:text-on-surface transition-colors col-hide-mobile">@customer.Email</td>
                            <td class="py-8 px-10 text-center font-headline text-lg italic text-on-surface/40 col-hide-mobile">@customer.TotalBookings</td>
                            <td class="py-8 px-10 text-center">
                                @if (customer.ActiveBookings > 0)
                                {
                                    <div class="inline-flex items-center gap-2 bg-secondary/10 px-4 py-2 border border-secondary/20 rounded-full">
                                        <div class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></div>
                                        <span class="font-label text-[9px] font-black uppercase tracking-widest text-secondary">Active (@customer.ActiveBookings)</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant opacity-30">Inactive</span>
                                }
                            </td>
                            <td class="py-8 px-10 text-center">
                                <a asp-action="ViewCustomerBookings" asp-route-customerId="@customer.CustomerId" class="inline-flex items-center justify-center py-4 px-8 border border-on-surface/20 text-on-surface font-label text-[10px] font-bold uppercase tracking-widest hover:bg-black hover:text-white hover:border-black transition-all duration-500 shadow-xl">
                                    Bookings
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-32 text-center">
                            <div class="max-w-xs mx-auto space-y-4">
                                <span class="material-symbols-outlined text-4xl text-outline-variant/30">sensor_occupied</span>
                                <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">No customers found.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>