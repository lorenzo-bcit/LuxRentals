@model IEnumerable<LuxRentals.ViewModels.Bookings.CustomerListViewModel>

@{
    ViewData["Title"] = "Customer Bookings";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">Customer Bookings Management</h1>
            <p class="text-muted">View and manage all customer vehicle reservations</p>
        </div>
    </div>

    <!-- Error Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Customer List -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-people-fill"></i> Customers with Bookings</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th class="text-center">Total Bookings</th>
                            <th class="text-center">Active Rentals</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@customer.FirstName @customer.LastName</strong>
                                </td>
                                <td>@customer.Email</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@customer.TotalBookings</span>
                                </td>
                                <td class="text-center">
                                    @if (customer.ActiveBookings > 0)
                                    {
                                        <span class="badge bg-primary">@customer.ActiveBookings</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="ViewCustomerBookings"
                                       asp-route-customerId="@customer.CustomerId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-calendar-check"></i> View Bookings
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
                <h3 class="mt-3">No Customers Found</h3>
                <p class="text-muted">No customers have made bookings yet.</p>
            </div>
        </div>
    }

</div>