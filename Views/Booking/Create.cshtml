@using LuxRentals.ViewModels.Bookings
@model BookingCreateViewModel

@{
    ViewData["Title"] = "Book Your Vehicle";
    var carId = ViewBag.CarId;
    var minBookingDate = (string)ViewBag.MinBookingDate;
    var minReturnDate = Model.StartDateTime.Date.AddDays(1).ToString("yyyy-MM-dd");
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Cars" asp-action="Index">Shop</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reserve</li>
                </ol>
            </nav>

            <!-- Booking Form Card -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Complete Your Reservation</h3>
                </div>
                <div class="card-body">

                    <!-- Show validation summary if errors exist -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="Create" asp-route-carId="@carId" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Pickup Date -->
                        <div class="mb-4">
                            <label asp-for="StartDateTime" class="form-label fw-bold">Pick-up</label>
                            <input asp-for="StartDateTime"
                                   type="date"
                                   class="form-control form-control-lg"
                                   min="@minBookingDate"
                                   value="@Model.StartDateTime.ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="StartDateTime" class="text-danger"></span>
                        </div>

                        <!-- Return Date -->
                        <div class="mb-4">
                            <label asp-for="EndDateTime" class="form-label fw-bold">Drop-off</label>
                            <input asp-for="EndDateTime"
                                   type="date"
                                   class="form-control form-control-lg"
                                   min="@minReturnDate"
                                   value="@Model.EndDateTime.ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="EndDateTime" class="text-danger"></span>
                        </div>

                        <!-- Information Box -->
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle-fill"></i>
                            <strong>Important:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Rental must start at least one day in the future</li>
                                <li>Return date must be after pickup date</li>
                                <li>You cannot have overlapping bookings</li>
                                <li>Cancellations must be made at least 2 days before pickup</li>
                            </ul>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-controller="Cars" asp-action="Index"
                               class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Back to Cars
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Confirm Booking
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startInput = document.querySelector('input[name="StartDateTime"]');
            const endInput = document.querySelector('input[name="EndDateTime"]');

            if (!startInput || !endInput) {
                return;
            }

            const addOneDay = (dateString) => {
                const date = new Date(`${dateString}T00:00:00Z`);
                date.setUTCDate(date.getUTCDate() + 1);
                return date.toISOString().split('T')[0];
            };

            const syncEndDateMinimum = () => {
                if (!startInput.value) {
                    return;
                }

                const minimumEndDate = addOneDay(startInput.value);
                endInput.min = minimumEndDate;

                if (!endInput.value || endInput.value < minimumEndDate) {
                    endInput.value = minimumEndDate;
                }
            };

            syncEndDateMinimum();
            startInput.addEventListener('change', syncEndDateMinimum);
        });
    </script>
}