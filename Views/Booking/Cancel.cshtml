@using LuxRentals.ViewModels.Bookings
@model BookingCancellationViewModel

@{
    ViewData["Title"] = "Relinquish Reservation";
    var isAdminOrEmployee = ViewBag.IsAdminOrEmployee ?? false;
    var bookingCustomerId = ViewBag.BookingCustomerId;
    var returnCarId = ViewBag.ReturnCarId;
}

<main class="grow flex items-center justify-center pt-32 pb-24 px-6 bg-surface min-h-screen">
    <div class="w-full max-w-2xl bg-surface-container-lowest p-12 md:p-16 shadow-[0_45px_100px_rgba(0,0,0,0.06)] border border-outline-variant/10">
        
        <!-- Header -->
        <header class="mb-16 border-b border-outline-variant/10 pb-12">
            <span class="font-label text-[10px] tracking-[0.4rem] uppercase text-secondary mb-4 block">Reservation Management</span>
            <h1 class="font-headline text-5xl font-black tracking-tighter uppercase mb-6">
                @(Model.CanCancel ? "Cancel Reservation" : "Cancellation Locked")
            </h1>
            <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-widest leading-loose">
                @(Model.CanCancel 
                    ? "Carefully review the details below before authorizing the removal of this selection from your itinerary." 
                    : "The designated window for self-authorized cancellation has concluded for this reservation.")
            </p>
        </header>

        <!-- Messages -->
        @if (TempData["Error"] != null)
        {
            <div class="mb-8 p-6 bg-error-container/10 border-l-4 border-error text-error text-[10px] uppercase tracking-widest font-bold">
                @TempData["Error"]
            </div>
        }

        <!-- Booking Summary -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16 border-b border-outline-variant/10 pb-12">
            <div class="space-y-4">
                <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Deployment Start</span>
                <span class="font-headline text-xl font-bold tracking-tight">@Model.StartDateTime.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="space-y-4">
                <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant block">Deployment End</span>
                <span class="font-headline text-xl font-bold tracking-tight">@Model.EndDateTime.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>

        @if (Model.CanCancel)
        {
            <!-- Warnings -->
            <div class="mb-16 p-8 bg-secondary-container/5 border border-secondary/20">
                <h5 class="font-headline text-sm font-black uppercase tracking-widest text-secondary mb-4">Authorization Required</h5>
                <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-widest leading-loose mb-8">
                    @Model.Message
                </p>
                <div class="space-y-3">
                    <div class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-secondary text-lg">info</span>
                        <span class="font-label text-[9px] uppercase tracking-[0.15em] text-on-surface-variant">Cancellations must be authorized at least 48 hours prior to deployment.</span>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-secondary text-lg">info</span>
                        <span class="font-label text-[9px] uppercase tracking-[0.15em] text-on-surface-variant">Once processed, this slot will be immediately returned to the public registry.</span>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <form asp-action="CancelConfirmed" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.PkBookingId" />
                @if (returnCarId != null)
                {
                    <input type="hidden" name="returnCarId" value="@returnCarId" />
                }

                <button type="submit" class="w-full py-6 bg-error text-white font-headline text-sm font-black uppercase tracking-[0.2em] hover:bg-black transition-colors duration-500 shadow-2xl">
                    AUTHORIZE CANCELLATION
                </button>

                @if (returnCarId != null)
                {
                    <a asp-area="Admin" asp-controller="Cars" asp-action="Edit" asp-route-id="@returnCarId" 
                       class="block w-full text-center py-6 border border-on-surface/20 text-on-surface hover:bg-black hover:text-white transition-all font-headline text-[10px] uppercase tracking-[0.2em] font-black">
                        ABORT CANCELLATION
                    </a>
                }
                else if (isAdminOrEmployee)
                {
                    <a asp-action="ViewCustomerBookings" asp-route-customerId="@bookingCustomerId"
                       class="block w-full text-center py-6 border border-on-surface/20 text-on-surface hover:bg-black hover:text-white transition-all font-headline text-[10px] uppercase tracking-[0.2em] font-black">
                        ABORT CANCELLATION
                    </a>
                }
                else
                {
                    <a asp-action="MyBookings" 
                       class="block w-full text-center py-6 border border-on-surface/20 text-on-surface hover:bg-black hover:text-white transition-all font-headline text-[10px] uppercase tracking-[0.2em] font-black">
                        ABORT CANCELLATION
                    </a>
                }
            </form>
        }
        else
        {
            <!-- Cannot Cancel -->
            <div class="mb-16 p-8 bg-surface-container-low border border-outline-variant/20">
                <h5 class="font-headline text-sm font-black uppercase tracking-widest text-outline mb-4">Access Restricted</h5>
                <p class="font-body text-[11px] text-on-surface-variant uppercase tracking-widest leading-loose mb-4">
                    @Model.Message
                </p>
                <p class="font-body text-[9px] text-outline/60 uppercase tracking-widest leading-relaxed">
                    Reservations within the designated 48-hour deployment widow are automatically finalized to ensure logistics and fleet preparation.
                </p>
            </div>

            <div class="space-y-6">
                @if (returnCarId != null)
                {
                    <a asp-area="Admin" asp-controller="Cars" asp-action="Edit" asp-route-id="@returnCarId" 
                       class="block w-full text-center py-6 bg-black text-secondary font-headline text-sm font-black uppercase tracking-[0.2em]">
                        RETURN TO REGISTRY
                    </a>
                }
                else if (isAdminOrEmployee)
                {
                    <a asp-action="ViewCustomerBookings" asp-route-customerId="@bookingCustomerId"
                       class="block w-full text-center py-6 bg-black text-secondary font-headline text-sm font-black uppercase tracking-[0.2em]">
                        RETURN TO CLIENT PORTFOLIO
                    </a>
                }
                else
                {
                    <a asp-action="MyBookings" 
                       class="block w-full text-center py-6 bg-black text-secondary font-headline text-sm font-black uppercase tracking-[0.2em]">
                        RETURN TO MY RESERVATIONS
                    </a>
                }
                
                <div class="text-center">
                    <p class="font-label text-[9px] text-outline uppercase tracking-widest mb-2">Need Assistance?</p>
                    <a href="mailto:support@luxrentals.com" class="font-label text-[10px] text-on-surface font-black uppercase tracking-widest hover:text-secondary transition-colors">
                        CONTACT SUPPORT LIAISON
                    </a>
                </div>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const cancelBtn = document.querySelector('button[type="submit"]');

            if (cancelBtn) {
                cancelBtn.addEventListener('click', function(e) {
                    if (!confirm('Are you absolutely sure you want to authorize the removal of this reservation? This process is final.')) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}