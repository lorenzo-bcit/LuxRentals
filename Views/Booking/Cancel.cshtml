@using LuxRentals.ViewModels.Bookings
@model BookingCancellationViewModel

@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Cancellation Card -->
            <div class="card shadow-lg">

                <!-- Card Header -->
                <div class="card-header text-white @(Model.CanCancel ? "bg-warning" : "bg-danger")">
                    <h3 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @(Model.CanCancel ? "Cancel Booking?" : "Cannot Cancel Booking")
                    </h3>
                </div>

                <div class="card-body p-4">

                    <!-- Error Messages from TempData -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Booking Summary -->
                    <div class="mb-4">
                        <h5 class="text-muted mb-3">Booking Details</h5>
                        <div class="p-3 bg-light rounded">
                            <p class="mb-2">
                                <i class="bi bi-calendar-event text-primary"></i>
                                <strong>Pickup:</strong> @Model.StartDateTime.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                            </p>
                            <p class="mb-0">
                                <i class="bi bi-calendar-x text-primary"></i>
                                <strong>Return:</strong> @Model.EndDateTime.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                            </p>
                        </div>
                    </div>

                    <!-- Message (Can Cancel or Cannot Cancel) -->
                    <div class="alert @(Model.CanCancel ? "alert-warning" : "alert-danger") mb-4" role="alert">
                        <h5 class="alert-heading">
                            @(Model.CanCancel ? "⚠️ Warning" : "❌ Cancellation Not Allowed")
                        </h5>
                        <p class="mb-0">@Model.Message</p>
                    </div>

                    @if (Model.CanCancel)
                    {
                        <!-- Cancellation Policy Info -->
                        <div class="mb-4">
                            <h6 class="text-muted">Cancellation Policy</h6>
                            <ul class="small">
                                <li>Cancellations can be made at least 48 hours before pickup</li>
                                <li>Once cancelled, this booking cannot be restored</li>
                                <li>You will receive a confirmation email</li>
                            </ul>
                        </div>

                        <!-- Confirm Cancellation Form -->
                        <form asp-action="CancelConfirmed" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.PkBookingId" />

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="bi bi-x-circle-fill"></i> Yes, Cancel This Booking
                                </button>
                                <a asp-action="MyBookings" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-arrow-left"></i> No, Keep This Booking
                                </a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <!-- Cannot Cancel - Show Back Button Only -->
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-secondary btn-lg" disabled>
                                <i class="bi bi-lock-fill"></i> Cancellation Not Available
                            </button>
                            <a asp-action="MyBookings" class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-left"></i> Back to My Bookings
                            </a>
                        </div>
                    }

                </div>

                <!-- Card Footer with Additional Info -->
                <div class="card-footer text-muted text-center">
                    <small>
                        <i class="bi bi-info-circle"></i>
                        Need help? Contact support at <a href="mailto:support@luxrentals.com">support@luxrentals.com</a>
                    </small>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confirmation dialog when cancelling
        document.addEventListener('DOMContentLoaded', function() {
            const cancelForm = document.querySelector('form[action*="CancelConfirmed"]');

            if (cancelForm) {
                cancelForm.addEventListener('submit', function(e) {
                    const confirmed = confirm('Are you absolutely sure you want to cancel this booking? This action cannot be undone.');

                    if (!confirmed) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}